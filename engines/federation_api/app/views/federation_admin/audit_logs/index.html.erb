<% content_for(:title, t("federation_admin.audit_logs.title")) %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("federation_admin.audit_logs.title") %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= t("federation_admin.audit_logs.subtitle") %></p>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <% if @logs.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <caption class="sr-only"><%= t("federation_admin.audit_logs.title") %></caption>
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.audit_logs.table.time") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.audit_logs.table.action") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.audit_logs.table.actor") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.audit_logs.table.target") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.audit_logs.table.ip") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.audit_logs.table.changes") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @logs.each do |log| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= format_date(log.created_at) %></td>
              <td class="px-4 py-3 text-sm">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-federation-100 text-federation-800">
                  <%= log.action %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700"><%= log.actor_email || "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500 font-mono"><%= log.target_type %>#<%= log.target_id %></td>
              <td class="px-4 py-3 text-sm text-gray-400 font-mono"><%= log.ip_address || "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500">
                <% if log.changes_made.present? && log.changes_made.any? %>
                  <details>
                    <summary class="cursor-pointer text-federation-600 hover:text-federation-800" aria-label="<%= t("federation_admin.audit_logs.table.changes") %>"><%= t("federation_admin.audit_logs.fields", count: log.changes_made.keys.count) %></summary>
                    <pre class="mt-1 text-xs bg-gray-50 p-2 rounded overflow-x-auto"><%= h(begin; JSON.pretty_generate(log.changes_made); rescue; log.changes_made.inspect; end) %></pre>
                  </details>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <!-- Pagination -->
    <% if @total_pages > 1 %>
      <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3">
        <div class="text-sm text-gray-700">
          <%= t('federation_admin.common.page', default: 'Page') %> <span class="font-medium"><%= @current_page %></span> <%= t('federation_admin.common.of', default: 'of') %> <span class="font-medium"><%= @total_pages %></span>
        </div>
        <div class="flex space-x-2">
          <% if @current_page > 1 %>
            <a href="<%= federation_admin_audit_logs_path(page: @current_page - 1) %>"
               class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              <%= t('federation_admin.common.previous', default: 'Previous') %>
            </a>
          <% end %>
          <% if @current_page < @total_pages %>
            <a href="<%= federation_admin_audit_logs_path(page: @current_page + 1) %>"
               class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              <%= t('federation_admin.common.next', default: 'Next') %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500"><%= t("federation_admin.audit_logs.empty") %></p>
    </div>
  <% end %>
</div>
