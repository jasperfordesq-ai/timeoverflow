<% content_for(:title) { @message.subject.presence || t("federation_hub.messages.title") } %>

<div class="row mb-3">
  <div class="col-md-12">
    <a href="<%= federation_hub_messages_path %>" class="text-muted">&larr; <%= t("federation_hub.messages.back") %></a>
  </div>
</div>

<div class="card border-info">
  <div class="card-header bg-info text-white d-flex justify-content-between">
    <span>
      <span class="badge <%= @message.inbound? ? 'bg-light text-dark' : 'bg-dark' %>">
        <%= @message.inbound? ? t("federation_hub.messages.received") : t("federation_hub.messages.sent_label") %>
      </span>
      <strong><%= @message.subject.presence || t("federation_hub.messages.no_subject") %></strong>
    </span>
    <small><%= @message.created_at.strftime("%d %b %Y %H:%M") %></small>
  </div>
  <div class="card-body">
    <p class="text-muted mb-2">
      <strong><%= @message.inbound? ? t("federation_hub.messages.from") : t("federation_hub.messages.to") %>:</strong>
      <%= @message.remote_user_identifier %>
      <% if @message.federation_partner %>
        (<%= @message.federation_partner.name %>)
      <% end %>
    </p>
    <hr>
    <div class="mt-3">
      <%= simple_format(@message.body) %>
    </div>
  </div>
</div>
