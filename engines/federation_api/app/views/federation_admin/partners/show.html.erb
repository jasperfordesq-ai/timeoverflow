<% content_for(:title, t("federation_admin.partners.show.page_title", name: @partner.name, default: "Partner: %{name}")) %>
<% content_for(:breadcrumbs) do %>
  <li class="text-gray-400">/</li>
  <li><a href="<%= federation_admin_partners_path %>" class="hover:text-federation-600"><%= t("federation_admin.layout.nav.partners") %></a></li>
  <li class="text-gray-400">/</li>
  <li class="text-gray-900 font-medium"><%= @partner.name %></li>
<% end %>

<div class="mb-8 sm:flex sm:items-center sm:justify-between">
  <div>
    <a href="<%= federation_admin_partners_path %>" class="text-sm text-federation-600 hover:text-federation-800">&larr; <%= t("federation_admin.partners.show.back") %></a>
    <h1 class="mt-2 text-2xl font-bold text-gray-900"><%= @partner.name %></h1>
  </div>
  <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
    <a href="<%= edit_federation_admin_partner_path(@partner) %>"
       class="inline-flex items-center bg-federation-600 hover:bg-federation-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
      <%= t("federation_admin.partners.show.edit") %>
    </a>
    <form method="post" action="<%= test_webhook_federation_admin_partner_path(@partner) %>" class="inline">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <button type="submit"
              class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors"
              data-disable-with="<%= t("federation_admin.partners.show.test_webhook") %>...">
        <%= t("federation_admin.partners.show.test_webhook") %>
      </button>
    </form>
    <form method="post" action="<%= regenerate_secret_federation_admin_partner_path(@partner) %>" class="inline"
          onsubmit="return confirm('<%= j t("federation_admin.partners.show.rotate_confirm") %>');">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <button type="submit"
              class="inline-flex items-center bg-yellow-500 hover:bg-yellow-600 text-white font-medium py-2 px-4 rounded-md transition-colors">
        <%= @partner.rotation_in_progress? ? t("federation_admin.partners.show.re_rotate_secret") : t("federation_admin.partners.show.rotate_secret") %>
      </button>
    </form>
    <% if @partner.rotation_in_progress? %>
      <form method="post" action="<%= complete_rotation_federation_admin_partner_path(@partner) %>" class="inline"
            onsubmit="return confirm('<%= j t("federation_admin.partners.show.complete_rotation_confirm") %>');">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit"
                class="inline-flex items-center bg-orange-500 hover:bg-orange-600 text-white font-medium py-2 px-4 rounded-md transition-colors">
          <%= t("federation_admin.partners.show.complete_rotation") %>
        </button>
      </form>
    <% end %>
    <form method="post" action="<%= health_check_federation_admin_partner_path(@partner) %>" class="inline">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <button type="submit"
              class="inline-flex items-center bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-md transition-colors"
              data-disable-with="<%= t("federation_admin.partners.show.health_check") %>...">
        <%= t("federation_admin.partners.show.health_check") %>
      </button>
    </form>
  </div>
</div>

<!-- Partner Info Card -->
<div class="bg-white shadow rounded-lg p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t("federation_admin.partners.show.details_title") %></h2>

  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.name") %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @partner.name %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.status") %></dt>
      <dd class="mt-1">
        <% status_colors = { "active" => "bg-green-100 text-green-800", "pending" => "bg-yellow-100 text-yellow-800", "suspended" => "bg-red-100 text-red-800", "terminated" => "bg-gray-100 text-gray-600" } %>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_colors[@partner.status] %>">
          <%= t("federation_admin.common.#{@partner.status}", default: @partner.status.capitalize) %>
        </span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.partnership_level") %></dt>
      <dd class="mt-1">
        <% level_colors = { 1 => "bg-gray-100 text-gray-700", 2 => "bg-blue-100 text-blue-800", 3 => "bg-purple-100 text-purple-800", 4 => "bg-federation-100 text-federation-800" } %>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= level_colors[@partner.partnership_level] %>">
          <%= t("federation_admin.dashboard.partner_health.level") %> <%= @partner.partnership_level %> &middot; <%= @partner.level_name %>
        </span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.platform_type") %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= t("federation_admin.common.platform_types.#{@partner.platform_type}", default: @partner.platform_type.capitalize) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.protocol_type") %></dt>
      <dd class="mt-1">
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-federation-100 text-federation-800">
          <%= Federation::Adapters.protocol_labels[@partner.protocol_type] || @partner.protocol_type %>
        </span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.api_endpoint") %></dt>
      <dd class="mt-1 text-sm font-mono text-gray-900 break-all"><%= @partner.api_endpoint %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.browse_base_url") %></dt>
      <dd class="mt-1 text-sm font-mono text-gray-900 break-all"><%= @partner.browse_base_url.present? ? @partner.browse_base_url : t("federation_admin.partners.show.using_api_endpoint") %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.webhook_url") %></dt>
      <dd class="mt-1 text-sm font-mono text-gray-900 break-all"><%= @partner.webhook_url.present? ? @partner.webhook_url : t("federation_admin.partners.show.not_configured") %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.webhook_secret") %></dt>
      <dd class="mt-1 text-sm font-mono text-gray-900">
        <span id="webhook-secret-masked">********************</span>
        <span id="webhook-secret-raw" class="hidden break-all"><%= @partner.webhook_secret %></span>
        <button onclick="var masked = document.getElementById('webhook-secret-masked'); var raw = document.getElementById('webhook-secret-raw'); if (raw.classList.contains('hidden')) { raw.classList.remove('hidden'); masked.classList.add('hidden'); this.textContent = '<%= j t("federation_admin.partners.show.hide") %>'; } else { raw.classList.add('hidden'); masked.classList.remove('hidden'); this.textContent = '<%= j t("federation_admin.partners.show.reveal") %>'; }"
                class="ml-2 text-xs text-federation-600 hover:text-federation-800 font-medium">
          <%= t("federation_admin.partners.show.reveal") %>
        </button>
        <% if @partner.rotation_in_progress? %>
          <span class="ml-3 inline-flex items-center rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-medium text-orange-800">
            <%= t("federation_admin.partners.show.rotation_in_progress", date: @partner.secret_rotation_started_at&.then { |t| format_date(t) }) %>
          </span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.feature_gates") %></dt>
      <dd class="mt-1">
        <% if @partner.feature_gates.present? %>
          <% gate_labels = { "profiles_enabled" => t("federation_admin.common.profiles"), "listings_enabled" => t("federation_admin.common.listings"), "transactions_enabled" => t("federation_admin.common.transactions"), "messaging_enabled" => t("federation_admin.common.messaging") } %>
          <% @partner.feature_gates.each do |gate, enabled| %>
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium mr-1 mb-1 <%= enabled ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-500 line-through' %>">
              <%= gate_labels[gate] || gate %>
            </span>
          <% end %>
        <% else %>
          <span class="text-gray-400 text-xs"><%= t("federation_admin.partners.show.none_configured") %></span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.permitted_orgs") %></dt>
      <dd class="mt-1 text-sm text-gray-900">
        <% if @permitted_orgs.blank? && (@partner.permitted_organization_ids.blank? || @partner.permitted_organization_ids.empty?) %>
          <span class="text-federation-600 font-medium"><%= t("federation_admin.partners.show.all_organizations") %></span>
        <% else %>
          <% (@permitted_orgs || []).each do |org| %>
            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700 mr-1 mb-1">
              <%= org.name %>
            </span>
          <% end %>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.consecutive_failures") %></dt>
      <dd class="mt-1 text-sm text-gray-900">
        <% if @partner.consecutive_failures == 0 %>
          <span class="text-green-600 font-medium">0</span>
        <% elsif @partner.consecutive_failures < 5 %>
          <span class="text-yellow-600 font-medium"><%= @partner.consecutive_failures %></span>
        <% else %>
          <span class="text-red-600 font-medium"><%= @partner.consecutive_failures %> <%= t("federation_admin.partners.show.auto_suspended") %></span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.last_health_check") %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @partner.last_health_check_at&.then { |t| format_date(t) } || t("federation_admin.partners.show.never") %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.created") %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @partner.created_at.then { |t| format_date(t) } %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= t("federation_admin.partners.show.updated") %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @partner.updated_at.then { |t| format_date(t) } %></dd>
    </div>
  </dl>
</div>

<!-- Recent Transactions -->
<div class="bg-white shadow rounded-lg p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t("federation_admin.partners.show.recent_transactions") %></h2>

  <% if @recent_transactions.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.id") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.direction") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.amount") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.remote_user") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.status") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.external_id") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.created") %></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @recent_transactions.each do |txn| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-500">#<%= txn.id %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= txn.inbound? ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= t("federation_admin.common.#{txn.direction}", default: txn.direction) %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 font-medium">
                <%= (txn.amount / 3600.0).round(2) %> <%= t("federation_admin.partners.show.table.hrs") %>
                <span class="text-gray-400 text-xs">(<%= txn.amount %>s)</span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 font-mono"><%= txn.remote_user_identifier %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% txn_colors = { "pending" => "bg-yellow-100 text-yellow-800", "completed" => "bg-green-100 text-green-800", "cancelled" => "bg-gray-100 text-gray-600", "disputed" => "bg-red-100 text-red-800" } %>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= txn_colors[txn.status] %>">
                  <%= t("federation_admin.common.#{txn.status}", default: txn.status) %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-500 text-xs"><%= txn.external_transaction_id || "-" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= txn.created_at.then { |t| format_date(t) } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-400 text-center py-6"><%= t("federation_admin.partners.show.no_transactions") %></p>
  <% end %>
</div>

<!-- Recent Webhooks -->
<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t("federation_admin.partners.show.recent_webhooks") %></h2>

  <% if @recent_webhooks.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.id") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.event_type") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.direction") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.status") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.response_code") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.show.table.created") %></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @recent_webhooks.each do |wh| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-500">#<%= wh.id %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900"><%= wh.event_type %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= wh.direction == 'inbound' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= t("federation_admin.common.#{wh.direction}", default: wh.direction) %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% wh_colors = { "pending" => "bg-yellow-100 text-yellow-800", "success" => "bg-green-100 text-green-800", "failed" => "bg-red-100 text-red-800" } %>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= wh_colors[wh.status] %>">
                  <%= t("federation_admin.common.#{wh.status}", default: wh.status) %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-500"><%= wh.response_code&.to_s.presence || "-" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= wh.created_at.then { |t| format_date(t) } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-400 text-center py-6"><%= t("federation_admin.partners.show.no_webhooks") %></p>
  <% end %>
</div>
