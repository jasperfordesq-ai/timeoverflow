<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? "#{yield(:title)} — " : "" %><%= t("federation_admin.layout.title") %></title>
  <%# Production-ready: compiled Tailwind CSS + Rails UJS bundled inline.
      No external CDN dependencies. To regenerate CSS after view changes:
      cd engines/federation_api && npx tailwindcss -i ./app/assets/stylesheets/federation_admin_input.css -o ./app/assets/stylesheets/federation_admin.css --minify %>
  <style><%= File.read(FederationApi::Engine.root.join("app/assets/stylesheets/federation_admin.css")) rescue "/* CSS not found — run: cd engines/federation_api && npx tailwindcss ... */" %></style>
  <script><%= raw File.read(FederationApi::Engine.root.join("app/assets/javascripts/rails-ujs.min.js")) rescue "" %></script>
  <script>if (typeof Rails !== 'undefined' && !window._rails_loaded) Rails.start();</script>
  <script><%= raw File.read(FederationApi::Engine.root.join("app/assets/javascripts/federation_form_helpers.js")) rescue "" %></script>
  <style>
    [data-flash] { animation: fadeOut 8s ease-in-out forwards; }
    @keyframes fadeOut { 0%,85% { opacity: 1; } 100% { opacity: 0; display: none; } }
  </style>
  <%= csrf_meta_tags %>
</head>
<body class="h-full">
  <div class="min-h-full">
    <!-- Alpha development notice -->
    <div class="bg-amber-500 text-amber-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2 text-center text-sm font-semibold">
        <%= t("federation_admin.layout.alpha_notice") %>
      </div>
    </div>
    <!-- Top navigation bar -->
    <nav class="bg-federation-800 shadow-lg">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Top row: brand + back link -->
        <div class="flex h-12 items-center justify-between">
          <a href="<%= federation_admin_root_path %>" class="flex items-center gap-2 text-white font-bold tracking-tight">
            <span class="text-xl">🔗</span>
            <%= t("federation_admin.layout.brand") %>
          </a>
          <a href="<%= main_app.root_path rescue '/' %>" class="text-federation-300 hover:text-white text-sm">
            &larr; <%= t("federation_admin.layout.back_to_timeoverflow") %>
          </a>
        </div>
      </div>
      <!-- Nav links row -->
      <div class="border-t border-federation-700">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex items-center gap-1 py-1 overflow-x-auto">
            <% nav_items = [
              [federation_admin_root_path, t("federation_admin.layout.nav.dashboard")],
              [federation_admin_partners_path, t("federation_admin.layout.nav.partners")],
              [federation_admin_api_keys_path, t("federation_admin.layout.nav.api_keys")],
              [federation_admin_transactions_path, t("federation_admin.layout.nav.transactions")],
              [federation_admin_messages_path, t("federation_admin.layout.nav.messages")],
              [federation_admin_webhook_logs_path, t("federation_admin.layout.nav.webhooks")],
              [federation_admin_org_settings_path, t("federation_admin.layout.nav.orgs")],
              [federation_admin_member_preferences_path, t("federation_admin.layout.nav.members")],
              [federation_admin_activity_index_path, t("federation_admin.layout.nav.activity")],
              [federation_admin_cc_config_index_path, t("federation_admin.layout.nav.cc_config")]
            ] %>
            <% nav_items.each do |path, label| %>
              <% is_active = (path == federation_admin_root_path) ? (request.path == path) : request.path.start_with?(path) %>
              <a href="<%= path %>"
                 class="<%= is_active ? 'bg-federation-900 text-white' : 'text-federation-200 hover:bg-federation-700 hover:text-white' %> whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors">
                <%= label %>
              </a>
            <% end %>
            <% if federation_stats[:transactions_pending] > 0 %>
              <span class="ml-auto inline-flex items-center rounded-full bg-yellow-400 px-2.5 py-0.5 text-xs font-semibold text-yellow-900 whitespace-nowrap">
                <%= t("federation_admin.layout.pending_count", count: federation_stats[:transactions_pending]) %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <% if flash[:notice] %>
      <div data-flash class="mx-auto max-w-7xl px-4 mt-4">
        <div class="rounded-md bg-green-50 border border-green-200 p-4">
          <p class="text-sm font-medium text-green-800"><%= flash[:notice] %></p>
        </div>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div data-flash class="mx-auto max-w-7xl px-4 mt-4">
        <div class="rounded-md bg-red-50 border border-red-200 p-4">
          <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
        </div>
      </div>
    <% end %>

    <!-- Main content -->
    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 mt-12">
      <div class="mx-auto max-w-7xl px-4 py-6 text-center text-xs text-gray-400">
        <%= t("federation_admin.layout.footer", version: FederationApi::VERSION) %>
      </div>
    </footer>
  </div>
</body>
</html>
