<% content_for(:title) { "Message ##{@message.id}" } %>

<!-- Page header -->
<div class="mb-8">
  <a href="<%= federation_admin_messages_path %>" class="inline-flex items-center text-sm text-federation-600 hover:text-federation-900 mb-3">
    <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    Back to Messages
  </a>
  <h1 class="text-2xl font-bold text-gray-900">Message #<%= @message.id %></h1>
</div>

<!-- Message detail card -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
    <h2 class="text-lg font-semibold text-gray-900">Message Details</h2>
  </div>

  <dl class="divide-y divide-gray-200">
    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">ID</dt>
      <dd class="text-sm text-gray-900 col-span-2 font-mono"><%= @message.id %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Partner</dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.federation_partner&.name || 'N/A' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Direction</dt>
      <dd class="text-sm col-span-2">
        <% if @message.direction == 'inbound' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Inbound</span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Outbound</span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Remote User Identifier</dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.remote_user_identifier || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Local Member ID</dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.local_member_id || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Organization ID</dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.organization_id || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Subject</dt>
      <dd class="text-sm text-gray-900 col-span-2 font-medium"><%= @message.subject || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Body</dt>
      <dd class="text-sm text-gray-900 col-span-2">
        <% if @message.body.present? %>
          <div class="bg-gray-50 rounded-lg border border-gray-200 p-4 whitespace-pre-wrap font-mono text-xs leading-relaxed"><%= @message.body %></div>
        <% else %>
          <span class="text-gray-400">No body content</span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Status</dt>
      <dd class="text-sm col-span-2">
        <% case @message.status %>
        <% when 'pending' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Pending</span>
        <% when 'delivered' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Delivered</span>
        <% when 'read' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-federation-100 text-federation-800">Read</span>
        <% when 'failed' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Failed</span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"><%= @message.status %></span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">External Message ID</dt>
      <dd class="text-sm text-gray-900 col-span-2 font-mono"><%= @message.external_message_id || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Delivered At</dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.delivered_at&.strftime('%Y-%m-%d %H:%M:%S UTC') || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Read At</dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.read_at&.strftime('%Y-%m-%d %H:%M:%S UTC') || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Metadata</dt>
      <dd class="text-sm text-gray-900 col-span-2">
        <% if @message.metadata.present? %>
          <div class="bg-gray-50 rounded-lg border border-gray-200 p-4 font-mono text-xs leading-relaxed"><%= JSON.pretty_generate(@message.metadata) %></div>
        <% else %>
          <span class="text-gray-400">None</span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Created At</dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.created_at.strftime('%Y-%m-%d %H:%M:%S UTC') %></dd>
    </div>
  </dl>
</div>
