<% content_for(:title, t("federation_admin.partners.index.title")) %>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= t("federation_admin.partners.index.title") %></h1>
    <p class="mt-1 text-sm text-gray-500"><%= t("federation_admin.partners.index.subtitle") %></p>
  </div>
  <div class="mt-4 sm:mt-0">
    <a href="<%= new_federation_admin_partner_path %>"
       class="inline-flex items-center bg-federation-600 hover:bg-federation-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
      <%= t("federation_admin.partners.index.register") %>
    </a>
  </div>
</div>

<div class="bg-white shadow rounded-lg overflow-x-auto scroll-shadow">
  <% if @partners.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <caption class="sr-only"><%= t("federation_admin.partners.index.title") %></caption>
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.name") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.platform") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.protocol") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.status") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.level") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.endpoint") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.orgs") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.health") %></th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("federation_admin.partners.index.table.actions") %></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @partners.each do |partner| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= partner.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 capitalize"><%= partner.platform_type %></td>
            <td class="px-6 py-4 whitespace-nowrap text-xs">
              <span class="inline-flex items-center rounded-full px-2 py-0.5 font-medium bg-federation-50 text-federation-700">
                <%= partner.protocol_type&.upcase || "REST" %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% status_colors = { "active" => "bg-green-100 text-green-800", "pending" => "bg-yellow-100 text-yellow-800", "suspended" => "bg-red-100 text-red-800", "terminated" => "bg-gray-100 text-gray-600" } %>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_colors[partner.status] || 'bg-gray-100 text-gray-600' %>">
                <%= t("federation_admin.common.#{partner.status}", default: partner.status.capitalize) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% level_colors = { 1 => "bg-gray-100 text-gray-700", 2 => "bg-blue-100 text-blue-800", 3 => "bg-purple-100 text-purple-800", 4 => "bg-federation-100 text-federation-800" } %>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= level_colors[partner.partnership_level] %>">
                L<%= partner.partnership_level %> &middot; <%= partner.level_name %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono text-xs max-w-xs truncate" title="<%= partner.api_endpoint %>">
              <%= truncate(partner.api_endpoint, length: 40) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if partner.permitted_organization_ids.blank? || partner.permitted_organization_ids.empty? %>
                <span class="text-federation-600 font-medium"><%= t("federation_admin.partners.show.all_organizations") %></span>
              <% else %>
                <%= partner.permitted_organization_ids.size %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if partner.consecutive_failures == 0 %>
                <span class="inline-block h-3 w-3 rounded-full bg-green-500" role="img" aria-label="<%= t('federation_admin.common.active') %>" title="<%= t('federation_admin.common.healthy') %>"></span>
                <span class="sr-only"><%= t('federation_admin.common.healthy', default: 'Status: Healthy') %></span>
              <% elsif partner.consecutive_failures < 5 %>
                <span class="inline-block h-3 w-3 rounded-full bg-yellow-500" role="img" aria-label="<%= t('federation_admin.partners.index.n_failures', count: partner.consecutive_failures, default: '%{count} failures') %>" title="<%= t('federation_admin.partners.index.n_failures', count: partner.consecutive_failures, default: '%{count} failures') %>"></span>
                <span class="sr-only"><%= t('federation_admin.partners.index.n_failures', count: partner.consecutive_failures, default: 'Status: Warning (%{count} failures)') %></span>
              <% else %>
                <span class="inline-block h-3 w-3 rounded-full bg-red-500" role="img" aria-label="<%= t('federation_admin.partners.index.n_failures', count: partner.consecutive_failures, default: '%{count} failures') %> (<%= t('federation_admin.common.suspended') %>)" title="<%= t('federation_admin.partners.index.n_failures', count: partner.consecutive_failures, default: '%{count} failures') %> (<%= t('federation_admin.common.suspended') %>)"></span>
                <span class="sr-only"><%= t('federation_admin.partners.index.n_failures', count: partner.consecutive_failures, default: 'Status: Error (%{count} failures)') %></span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
              <a href="<%= federation_admin_partner_path(partner) %>" class="text-federation-600 hover:text-federation-800"><%= t("federation_admin.partners.index.view") %></a>
              <a href="<%= edit_federation_admin_partner_path(partner) %>" class="text-gray-600 hover:text-gray-800"><%= t("federation_admin.partners.index.edit") %></a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @total_pages > 1 %>
      <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3">
        <div class="text-sm text-gray-700">
          <%= t('federation_admin.common.page', default: 'Page') %> <span class="font-medium"><%= @current_page %></span> <%= t('federation_admin.common.of', default: 'of') %> <span class="font-medium"><%= @total_pages %></span>
        </div>
        <div class="flex space-x-2">
          <% if @current_page > 1 %>
            <a href="<%= federation_admin_partners_path(request.query_parameters.merge(page: @current_page - 1)) %>"
               class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              <%= t('federation_admin.common.previous', default: 'Previous') %>
            </a>
          <% end %>
          <% if @current_page < @total_pages %>
            <a href="<%= federation_admin_partners_path(request.query_parameters.merge(page: @current_page + 1)) %>"
               class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
              <%= t('federation_admin.common.next', default: 'Next') %>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500"><%= t("federation_admin.partners.index.empty") %></p>
      <a href="<%= new_federation_admin_partner_path %>"
         class="mt-4 inline-flex items-center text-sm font-medium text-federation-600 hover:text-federation-800">
        <%= t("federation_admin.partners.index.register_first") %>
      </a>
    </div>
  <% end %>
</div>
