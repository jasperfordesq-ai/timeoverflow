<% content_for(:title, "Transactions") %>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Federation Transactions</h1>
    <p class="mt-1 text-sm text-gray-500"><%= @total_count %> total transaction<%= @total_count == 1 ? '' : 's' %></p>
  </div>
</div>

<!-- Filter Bar -->
<div class="bg-white shadow rounded-lg p-4 mb-6">
  <form method="get" action="<%= federation_admin_transactions_path %>" class="flex flex-wrap items-end gap-4">
    <div>
      <label for="status" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Status</label>
      <select name="status" id="status" onchange="this.form.submit()"
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value="">All Statuses</option>
        <% %w[pending completed cancelled disputed].each do |s| %>
          <option value="<%= s %>" <%= params[:status] == s ? 'selected' : '' %>><%= s.capitalize %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="direction" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Direction</label>
      <select name="direction" id="direction" onchange="this.form.submit()"
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value="">All Directions</option>
        <% %w[inbound outbound].each do |d| %>
          <option value="<%= d %>" <%= params[:direction] == d ? 'selected' : '' %>><%= d.capitalize %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="partner_id" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Partner</label>
      <select name="partner_id" id="partner_id" onchange="this.form.submit()"
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value="">All Partners</option>
        <% @partners.each do |partner| %>
          <option value="<%= partner.id %>" <%= params[:partner_id].to_s == partner.id.to_s ? 'selected' : '' %>><%= partner.name %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="organization_id" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Organization</label>
      <select name="organization_id" id="organization_id" onchange="this.form.submit()"
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value="">All Organizations</option>
        <% @organizations.each do |org| %>
          <option value="<%= org.id %>" <%= params[:organization_id].to_s == org.id.to_s ? 'selected' : '' %>><%= org.name %></option>
        <% end %>
      </select>
    </div>

    <% if params[:status].present? || params[:direction].present? || params[:partner_id].present? || params[:organization_id].present? %>
      <div>
        <a href="<%= federation_admin_transactions_path %>"
           class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700">
          Clear filters
        </a>
      </div>
    <% end %>
  </form>
</div>

<!-- Table -->
<div class="bg-white shadow rounded-lg overflow-hidden">
  <% if @transactions.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">External ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Partner</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Org ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Direction</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Transfer ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @transactions.each do |txn| %>
            <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='<%= federation_admin_transaction_path(txn) %>'">
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap font-mono"><%= txn.id %></td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap font-mono" title="<%= txn.external_transaction_id %>">
                <%= truncate(txn.external_transaction_id.to_s, length: 16) %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
                <%= txn.federation_partner&.name || "N/A" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= txn.organization_id %></td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= direction_badge_class(txn.direction) %>">
                  <%= txn.direction %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap font-medium">
                <%= (txn.amount.to_f / 3600).round(2) %>h
              </td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_badge_class(txn.status) %>">
                  <%= txn.status %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap font-mono"><%= txn.transfer_id || "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= txn.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3 mt-4">
      <div class="text-sm text-gray-700">
        Page <span class="font-medium"><%= @current_page %></span> of <span class="font-medium"><%= @total_pages %></span>
      </div>
      <div class="flex space-x-2">
        <% if @current_page > 1 %>
          <a href="<%= federation_admin_transactions_path(request.query_parameters.merge(page: @current_page - 1)) %>"
             class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Previous
          </a>
        <% else %>
          <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 opacity-50 cursor-not-allowed">
            Previous
          </span>
        <% end %>

        <% if @current_page < @total_pages %>
          <a href="<%= federation_admin_transactions_path(request.query_parameters.merge(page: @current_page + 1)) %>"
             class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Next
          </a>
        <% else %>
          <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 opacity-50 cursor-not-allowed">
            Next
          </span>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500">No transactions found.</p>
    </div>
  <% end %>
</div>
