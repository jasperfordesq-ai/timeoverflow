<% content_for(:title, "Partner: #{@partner.name}") %>

<div class="mb-8 sm:flex sm:items-center sm:justify-between">
  <div>
    <a href="<%= federation_admin_partners_path %>" class="text-sm text-federation-600 hover:text-federation-800">&larr; Back to Partners</a>
    <h1 class="mt-2 text-2xl font-bold text-gray-900"><%= @partner.name %></h1>
  </div>
  <div class="mt-4 sm:mt-0">
    <a href="<%= edit_federation_admin_partner_path(@partner) %>"
       class="inline-flex items-center bg-federation-600 hover:bg-federation-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
      Edit Partner
    </a>
  </div>
</div>

<!-- Partner Info Card -->
<div class="bg-white shadow rounded-lg p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Partner Details</h2>

  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
    <div>
      <dt class="text-sm font-medium text-gray-500">Name</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @partner.name %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Status</dt>
      <dd class="mt-1">
        <% status_colors = { "active" => "bg-green-100 text-green-800", "pending" => "bg-yellow-100 text-yellow-800", "suspended" => "bg-red-100 text-red-800", "terminated" => "bg-gray-100 text-gray-600" } %>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_colors[@partner.status] %>">
          <%= @partner.status.capitalize %>
        </span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Partnership Level</dt>
      <dd class="mt-1">
        <% level_colors = { 1 => "bg-gray-100 text-gray-700", 2 => "bg-blue-100 text-blue-800", 3 => "bg-purple-100 text-purple-800", 4 => "bg-federation-100 text-federation-800" } %>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= level_colors[@partner.partnership_level] %>">
          Level <%= @partner.partnership_level %> &middot; <%= @partner.level_name %>
        </span>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Platform Type</dt>
      <dd class="mt-1 text-sm text-gray-900 capitalize"><%= @partner.platform_type %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">API Endpoint</dt>
      <dd class="mt-1 text-sm font-mono text-gray-900 break-all"><%= @partner.api_endpoint %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Webhook URL</dt>
      <dd class="mt-1 text-sm font-mono text-gray-900 break-all"><%= @partner.webhook_url.present? ? @partner.webhook_url : "Not configured" %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Webhook Secret</dt>
      <dd class="mt-1 text-sm font-mono text-gray-900">
        <span id="webhook-secret-masked">********************</span>
        <span id="webhook-secret-raw" class="hidden break-all"><%= @partner.webhook_secret %></span>
        <button onclick="var masked = document.getElementById('webhook-secret-masked'); var raw = document.getElementById('webhook-secret-raw'); if (raw.classList.contains('hidden')) { raw.classList.remove('hidden'); masked.classList.add('hidden'); this.textContent = 'Hide'; } else { raw.classList.add('hidden'); masked.classList.remove('hidden'); this.textContent = 'Reveal'; }"
                class="ml-2 text-xs text-federation-600 hover:text-federation-800 font-medium">
          Reveal
        </button>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Feature Gates</dt>
      <dd class="mt-1">
        <% if @partner.feature_gates.present? %>
          <% gate_labels = { "profiles_enabled" => "Profiles", "listings_enabled" => "Listings", "transactions_enabled" => "Transactions", "messaging_enabled" => "Messaging" } %>
          <% @partner.feature_gates.each do |gate, enabled| %>
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium mr-1 mb-1 <%= enabled ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-500 line-through' %>">
              <%= gate_labels[gate] || gate %>
            </span>
          <% end %>
        <% else %>
          <span class="text-gray-400 text-xs">None configured</span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Permitted Organizations</dt>
      <dd class="mt-1 text-sm text-gray-900">
        <% if @partner.permitted_organization_ids.blank? || @partner.permitted_organization_ids.empty? %>
          <span class="text-federation-600 font-medium">All organizations</span>
        <% else %>
          <% @partner.permitted_organization_ids.each do |org_id| %>
            <% org = Organization.find_by(id: org_id) %>
            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700 mr-1 mb-1">
              <%= org&.name || "Org ##{org_id}" %>
            </span>
          <% end %>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Consecutive Failures</dt>
      <dd class="mt-1 text-sm text-gray-900">
        <% if @partner.consecutive_failures == 0 %>
          <span class="text-green-600 font-medium">0</span>
        <% elsif @partner.consecutive_failures < 5 %>
          <span class="text-yellow-600 font-medium"><%= @partner.consecutive_failures %></span>
        <% else %>
          <span class="text-red-600 font-medium"><%= @partner.consecutive_failures %> (auto-suspended)</span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Last Health Check</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @partner.last_health_check_at&.strftime("%Y-%m-%d %H:%M:%S UTC") || "Never" %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Created</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @partner.created_at.strftime("%Y-%m-%d %H:%M:%S UTC") %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Updated</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @partner.updated_at.strftime("%Y-%m-%d %H:%M:%S UTC") %></dd>
    </div>
  </dl>
</div>

<!-- Recent Transactions -->
<div class="bg-white shadow rounded-lg p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Recent Transactions</h2>

  <% if @recent_transactions.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Direction</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Remote User</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">External ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @recent_transactions.each do |txn| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-500">#<%= txn.id %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= txn.inbound? ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= txn.direction %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 font-medium">
                <%= (txn.amount / 3600.0).round(2) %> hrs
                <span class="text-gray-400 text-xs">(<%= txn.amount %>s)</span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 font-mono"><%= txn.remote_user_identifier %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% txn_colors = { "pending" => "bg-yellow-100 text-yellow-800", "completed" => "bg-green-100 text-green-800", "cancelled" => "bg-gray-100 text-gray-600", "disputed" => "bg-red-100 text-red-800" } %>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= txn_colors[txn.status] %>">
                  <%= txn.status %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-500 text-xs"><%= txn.external_transaction_id || "-" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= txn.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-400 text-center py-6">No transactions recorded for this partner.</p>
  <% end %>
</div>

<!-- Recent Webhooks -->
<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Recent Webhooks</h2>

  <% if @recent_webhooks.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event Type</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Direction</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Response Code</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @recent_webhooks.each do |wh| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-500">#<%= wh.id %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900"><%= wh.event_type %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= wh.direction == 'inbound' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= wh.direction %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% wh_colors = { "pending" => "bg-yellow-100 text-yellow-800", "success" => "bg-green-100 text-green-800", "failed" => "bg-red-100 text-red-800" } %>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= wh_colors[wh.status] %>">
                  <%= wh.status %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-gray-500"><%= wh.try(:response_code) || "-" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= wh.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-400 text-center py-6">No webhooks recorded for this partner.</p>
  <% end %>
</div>
