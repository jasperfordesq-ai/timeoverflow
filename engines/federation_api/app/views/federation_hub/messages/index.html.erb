<% content_for(:title) { t("federation_hub.messages.title") } %>

<div class="row mb-3">
  <div class="col-md-8">
    <h1><%= t("federation_hub.messages.title") %></h1>
  </div>
  <div class="col-md-4 text-end">
    <a href="<%= new_federation_hub_message_path %>" class="btn btn-info">
      <%= t("federation_hub.messages.compose") %>
    </a>
  </div>
</div>

<% if @conversations.any? %>
  <% @conversations.each do |convo| %>
    <a href="<%= federation_hub_message_path(convo[:latest_message]) %>" class="text-decoration-none">
      <div class="card mb-2 <%= convo[:unread_count] > 0 ? 'card-info border-info' : '' %>">
        <div class="card-body py-2">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <% if convo[:unread_count] > 0 %>
                <span class="badge bg-warning text-dark me-1"><%= convo[:unread_count] %></span>
              <% end %>
              <strong class="text-dark"><%= convo[:remote_user_name] %></strong>
              <small class="text-muted ms-2"><%= convo[:partner_name] %></small>
            </div>
            <div>
              <small class="text-muted"><%= t("federation_hub.messages.time_ago", time: time_ago_in_words(convo[:last_activity])) %></small>
              <% if convo[:message_count] > 1 %>
                <span class="badge bg-secondary ms-1"><%= convo[:message_count] %></span>
              <% end %>
            </div>
          </div>
          <div class="mt-1">
            <% latest = convo[:latest_message] %>
            <small class="text-muted">
              <% if latest.outbound? %>
                <span class="text-info"><%= t("federation_hub.messages.you") %>:</span>
              <% end %>
              <%= truncate(latest.body.to_s, length: 100) %>
            </small>
          </div>
        </div>
      </div>
    </a>
  <% end %>
<% else %>
  <div class="alert alert-info">
    <%= t("federation_hub.messages.none") %>
  </div>
<% end %>
