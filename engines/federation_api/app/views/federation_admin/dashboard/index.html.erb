<% content_for(:title) { t("federation_admin.layout.nav.dashboard") } %>

<!-- Page header with reconciliation trigger -->
<div class="mb-8 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= t("federation_admin.dashboard.title") %></h1>
    <p class="mt-1 text-sm text-gray-500"><%= t("federation_admin.dashboard.subtitle") %></p>
  </div>
  <form method="post" action="<%= federation_admin_reconcile_path %>">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <button type="submit" class="inline-flex items-center gap-2 rounded-md bg-federation-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-federation-700 transition-colors"
            onclick="return confirm('<%= j t("federation_admin.dashboard.run_reconciliation_confirm") %>')">
      🔄 <%= t("federation_admin.dashboard.run_reconciliation") %>
    </button>
  </form>
</div>

<!-- Stats cards -->
<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 mb-10">

  <!-- Organizations -->
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <div class="flex items-center gap-3 mb-3">
      <div class="flex-shrink-0 rounded-lg bg-blue-50 p-2.5">
        <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
      </div>
      <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.organizations") %></span>
    </div>
    <p class="text-3xl font-bold text-gray-900"><%= @stats[:organizations] %></p>
  </div>

  <!-- Active Partners -->
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <div class="flex items-center gap-3 mb-3">
      <div class="flex-shrink-0 rounded-lg <%= @stats[:active_partners] > 0 ? 'bg-green-50' : 'bg-gray-50' %> p-2.5">
        <svg class="h-5 w-5 <%= @stats[:active_partners] > 0 ? 'text-green-600' : 'text-gray-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
        <span class="sr-only"><%= @stats[:active_partners] > 0 ? t("federation_admin.common.healthy") : t("federation_admin.dashboard.stats.no_active_partners") %></span>
      </div>
      <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.active_partners") %></span>
    </div>
    <p class="text-3xl font-bold text-gray-900">
      <%= @stats[:active_partners] %>
      <span class="text-base font-normal text-gray-400">/ <%= @stats[:total_partners] %></span>
    </p>
  </div>

  <!-- Active API Keys -->
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <div class="flex items-center gap-3 mb-3">
      <div class="flex-shrink-0 rounded-lg bg-purple-50 p-2.5">
        <svg class="h-5 w-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
      </div>
      <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.active_api_keys") %></span>
    </div>
    <p class="text-3xl font-bold text-gray-900"><%= @stats[:active_api_keys] %></p>
  </div>

  <!-- Transactions -->
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <div class="flex items-center gap-3 mb-3">
      <div class="flex-shrink-0 rounded-lg bg-federation-50 p-2.5">
        <svg class="h-5 w-5 text-federation-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
        </svg>
      </div>
      <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.transactions") %></span>
    </div>
    <p class="text-3xl font-bold text-gray-900">
      <%= @stats[:completed_transactions] %>
      <span class="text-base font-normal text-gray-400">/ <%= @stats[:total_transactions] %></span>
    </p>
    <% txn_diff = @trends[:transactions_7d] - @trends[:transactions_prev_7d] %>
    <% if txn_diff != 0 %>
      <span class="mt-1 inline-flex items-center text-xs font-medium <%= txn_diff > 0 ? 'text-green-600' : 'text-red-500' %>">
        <%= txn_diff > 0 ? "+" : "" %><%= txn_diff %> <span class="text-gray-400 ml-0.5"><%= t("federation_admin.dashboard.stats.vs_prev_7d") %></span>
      </span>
    <% end %>
    <% if @stats[:pending_transactions] > 0 %>
      <span class="mt-2 inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-semibold text-yellow-800">
        <%= @stats[:pending_transactions] %> <%= t("federation_admin.common.pending").downcase %>
      </span>
    <% end %>
    <% if @stats[:disputed_transactions] > 0 %>
      <span class="mt-2 inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-800">
        <%= @stats[:disputed_transactions] %> <%= t("federation_admin.common.disputed").downcase %>
      </span>
    <% end %>
  </div>

  <!-- Time Flow -->
  <% net_seconds = (@stats[:total_inbound] || 0) - (@stats[:total_outbound] || 0) %>
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <div class="flex items-center gap-3 mb-3">
      <div class="flex-shrink-0 rounded-lg bg-cyan-50 p-2.5">
        <svg class="h-5 w-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.time_flow") %></span>
    </div>
    <div class="space-y-1">
      <div class="flex items-center justify-between text-sm">
        <span class="text-green-600 font-medium"><%= t("federation_admin.dashboard.stats.in") %></span>
        <span class="font-semibold text-gray-700"><%= (@stats[:total_inbound] / 3600.0).round(1) %>h</span>
      </div>
      <div class="flex items-center justify-between text-sm">
        <span class="text-red-500 font-medium"><%= t("federation_admin.dashboard.stats.out") %></span>
        <span class="font-semibold text-gray-700"><%= (@stats[:total_outbound] / 3600.0).round(1) %>h</span>
      </div>
      <div class="border-t border-gray-100 pt-1 flex items-center justify-between text-sm">
        <span class="text-gray-500 font-medium"><%= t("federation_admin.dashboard.stats.net") %></span>
        <span class="font-bold <%= net_seconds >= 0 ? 'text-green-600' : 'text-red-600' %>">
          <%= net_seconds >= 0 ? '+' : '' %><%= (net_seconds / 3600.0).round(1) %>h
        </span>
      </div>
    </div>
  </div>

  <!-- Failed Webhooks 24h -->
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <div class="flex items-center gap-3 mb-3">
      <div class="flex-shrink-0 rounded-lg <%= @stats[:failed_webhooks_24h] > 0 ? 'bg-red-50' : 'bg-green-50' %> p-2.5">
        <svg class="h-5 w-5 <%= @stats[:failed_webhooks_24h] > 0 ? 'text-red-600' : 'text-green-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <% if @stats[:failed_webhooks_24h] > 0 %>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
          <% else %>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          <% end %>
        </svg>
        <span class="sr-only"><%= @stats[:failed_webhooks_24h] > 0 ? t("federation_admin.dashboard.stats.n_failures", count: @stats[:failed_webhooks_24h]) : t("federation_admin.dashboard.stats.all_healthy") %></span>
      </div>
      <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.failed_webhooks_24h") %></span>
    </div>
    <p class="text-3xl font-bold <%= @stats[:failed_webhooks_24h] > 0 ? 'text-red-600' : 'text-gray-900' %>">
      <%= @stats[:failed_webhooks_24h] %>
    </p>
  </div>
</div>

<!-- Consent & Messaging row -->
<div class="grid grid-cols-1 gap-5 sm:grid-cols-3 mb-10">
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.orgs_federation_enabled") %></span>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:orgs_federation_enabled] %> <span class="text-base font-normal text-gray-400">/ <%= @stats[:organizations] %></span></p>
  </div>
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.members_opted_in") %></span>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:members_opted_in] %></p>
  </div>
  <div class="bg-white overflow-hidden rounded-xl shadow-sm border border-gray-200 px-5 py-5">
    <span class="text-sm font-medium text-gray-500"><%= t("federation_admin.dashboard.stats.federation_messages") %></span>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:messages_total] %> <span class="text-base font-normal text-gray-400">(<%= @stats[:messages_inbound] %> <%= t("federation_admin.common.inbound").downcase %>)</span></p>
    <% msg_diff = @trends[:messages_7d] - @trends[:messages_prev_7d] %>
    <% if msg_diff != 0 %>
      <span class="inline-flex items-center text-xs font-medium <%= msg_diff > 0 ? 'text-green-600' : 'text-red-500' %>">
        <%= msg_diff > 0 ? "+" : "" %><%= msg_diff %> <span class="text-gray-400 ml-0.5"><%= t("federation_admin.dashboard.stats.vs_prev_7d") %></span>
      </span>
    <% end %>
  </div>
</div>

<!-- Two-column layout: Transactions + Partner Health -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

  <!-- Left: Recent Transactions (2/3 width) -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
        <div>
          <h2 class="text-base font-semibold text-gray-900"><%= t("federation_admin.dashboard.recent_transactions.title") %></h2>
          <p class="text-sm text-gray-500 mt-0.5"><%= t("federation_admin.dashboard.recent_transactions.subtitle") %></p>
        </div>
        <a href="<%= federation_admin_transactions_path %>" class="text-sm font-medium text-federation-600 hover:text-federation-800 transition-colors">
          <%= t("federation_admin.dashboard.recent_transactions.view_all") %> &rarr;
        </a>
      </div>

      <% if @recent_transactions.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <caption class="sr-only"><%= t("federation_admin.dashboard.recent_transactions.title") %></caption>
            <thead>
              <tr class="bg-gray-50">
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("federation_admin.dashboard.table.id") %></th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("federation_admin.dashboard.table.partner") %></th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("federation_admin.dashboard.table.direction") %></th>
                <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("federation_admin.dashboard.table.amount") %></th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("federation_admin.dashboard.table.status") %></th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t("federation_admin.dashboard.table.created") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @recent_transactions.each do |txn| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-3.5 whitespace-nowrap text-sm font-mono text-gray-600">
                    <a href="<%= federation_admin_transaction_path(txn) %>" class="text-federation-600 hover:text-federation-800">#<%= txn.id %></a>
                  </td>
                  <td class="px-6 py-3.5 whitespace-nowrap text-sm text-gray-900 font-medium">
                    <%= txn.federation_partner&.name || t("federation_admin.common.unknown", default: "Unknown") %>
                  </td>
                  <td class="px-6 py-3.5 whitespace-nowrap text-sm">
                    <% if txn.inbound? %>
                      <span class="inline-flex items-center gap-1 text-green-700">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                        <%= t("federation_admin.common.inbound") %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1 text-blue-700">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                        <%= t("federation_admin.common.outbound") %>
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-3.5 whitespace-nowrap text-sm text-right font-semibold text-gray-900">
                    <%= (txn.amount / 3600.0).round(1) %>h
                  </td>
                  <td class="px-6 py-3.5 whitespace-nowrap">
                    <%
                      status_colors = {
                        "completed" => "bg-green-100 text-green-800",
                        "pending"   => "bg-yellow-100 text-yellow-800",
                        "cancelled" => "bg-gray-100 text-gray-600",
                        "disputed"  => "bg-red-100 text-red-800"
                      }
                      color_class = status_colors[txn.status] || "bg-gray-100 text-gray-600"
                    %>
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= color_class %>">
                      <%= t("federation_admin.common.#{txn.status}") %>
                    </span>
                  </td>
                  <td class="px-6 py-3.5 whitespace-nowrap text-sm text-gray-500">
                    <%= format_date(txn.created_at) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-16 text-center">
          <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
          </svg>
          <p class="mt-3 text-sm text-gray-500"><%= t("federation_admin.dashboard.recent_transactions.empty") %></p>
          <p class="text-xs text-gray-400 mt-1"><%= t("federation_admin.dashboard.recent_transactions.empty_detail") %></p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Right: Partner Health (1/3 width) -->
  <div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
        <div>
          <h2 class="text-base font-semibold text-gray-900"><%= t("federation_admin.dashboard.partner_health.title") %></h2>
          <p class="text-sm text-gray-500 mt-0.5"><%= @partners.count %> <%= t("federation_admin.dashboard.partner_health.registered_partners") %></p>
        </div>
        <a href="<%= federation_admin_partners_path %>" class="text-sm font-medium text-federation-600 hover:text-federation-800 transition-colors">
          <%= t("federation_admin.dashboard.partner_health.manage") %> &rarr;
        </a>
      </div>

      <% if @partners.any? %>
        <ul class="divide-y divide-gray-100">
          <% @partners.each do |partner| %>
            <li class="px-6 py-4 hover:bg-gray-50 transition-colors">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-semibold text-gray-900 truncate"><%= partner.name %></p>
                  <div class="flex flex-wrap items-center gap-2 mt-1.5">
                    <%
                      partner_status_colors = {
                        "active"     => "bg-green-100 text-green-800",
                        "pending"    => "bg-yellow-100 text-yellow-800",
                        "suspended"  => "bg-gray-100 text-gray-600",
                        "terminated" => "bg-red-100 text-red-800"
                      }
                      partner_color = partner_status_colors[partner.status] || "bg-gray-100 text-gray-600"
                    %>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold <%= partner_color %>">
                      <%= t("federation_admin.common.#{partner.status}") %>
                    </span>
                    <span class="inline-flex items-center rounded-full bg-federation-50 text-federation-700 px-2 py-0.5 text-xs font-medium">
                      L<%= partner.partnership_level %> &middot; <%= partner.level_name %>
                    </span>
                  </div>
                </div>
                <% if partner.consecutive_failures > 0 %>
                  <span class="flex-shrink-0 inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-700" title="<%= t("federation_admin.dashboard.partner_health.consecutive_failures") %>">
                    <%= t("federation_admin.dashboard.partner_health.n_failures", count: partner.consecutive_failures, default: "%{count} failures") %>
                  </span>
                <% end %>
              </div>
              <div class="mt-2 text-xs text-gray-400">
                <% if partner.last_health_check_at.present? %>
                  <%= t("federation_admin.dashboard.partner_health.last_check") %> <%= t("federation_admin.dashboard.partner_health.time_ago", time: time_ago_in_words(partner.last_health_check_at)) %>
                <% else %>
                  <%= t("federation_admin.dashboard.partner_health.no_activity") %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="px-6 py-16 text-center">
          <svg class="mx-auto h-10 w-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
          <p class="mt-3 text-sm text-gray-500"><%= t("federation_admin.dashboard.partner_health.empty") %></p>
          <p class="text-xs text-gray-400 mt-1">
            <a href="<%= federation_admin_partners_path %>" class="text-federation-600 hover:underline"><%= t("federation_admin.dashboard.partner_health.add_first") %></a> <%= t("federation_admin.dashboard.partner_health.to_start") %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
