<% content_for(:title) { t("federation_hub.transfers.title") } %>
<% content_for(:breadcrumbs) do %>
  <li class="breadcrumb-item active" aria-current="page"><%= t("federation_hub.nav.transfers") %></li>
<% end %>

<div class="row">
  <div class="col-md-12">
    <h1><%= t("federation_hub.transfers.title") %></h1>
    <p class="text-muted"><%= t("federation_hub.transfers.subtitle") %></p>
  </div>
</div>

<%# Step 1: Select target community %>
<div class="row mb-4">
  <div class="col-md-6">
    <form method="get" action="<%= new_federation_hub_transfer_path %>" aria-label="<%= t('federation_hub.transfers.select_org') %>">
      <label for="org_id_select" class="form-label fw-bold"><%= t("federation_hub.transfers.select_org") %></label>
      <div class="input-group">
        <select name="org_id" id="org_id_select" class="form-control" required onchange="
          var opt = this.options[this.selectedIndex];
          document.getElementById('transfer_source_type').value = opt.dataset.type || '';
          this.form.submit();
        ">
          <option value=""><%= t("federation_hub.transfers.choose_org") %></option>

          <% if @internal_orgs.any? %>
            <optgroup label="<%= t("federation_hub.common.internal_orgs") %>">
              <% @internal_orgs.each do |org| %>
                <option value="<%= org.id %>"
                        data-type="internal"
                        <%= 'selected' if @selected_id.to_s == org.id.to_s && @selected_type != "external" %>>
                  <%= org.name %>
                </option>
              <% end %>
            </optgroup>
          <% end %>

          <% if @external_partners.any? %>
            <optgroup label="<%= t("federation_hub.common.external_partners") %>">
              <% @external_partners.each do |p| %>
                <option value="<%= p.id %>"
                        data-type="external"
                        <%= 'selected' if @selected_id.to_s == p.id.to_s && @selected_type == "external" %>>
                  <%= p.name %>
                </option>
              <% end %>
            </optgroup>
          <% end %>
        </select>
        <input type="hidden" name="source_type" id="transfer_source_type" value="<%= @selected_type %>">
        <button type="submit" class="btn btn-info"><%= t("federation_hub.transfers.select") %></button>
      </div>
    </form>
  </div>
</div>

<% if @selected_id.blank? %>
  <div class="alert alert-info">
    <% if @internal_orgs.any? || @external_partners.any? %>
      <%= t("federation_hub.transfers.choose_org_prompt") %>
    <% else %>
      <%= t("federation_hub.transfers.no_orgs_available") %>
    <% end %>
  </div>
<% elsif @destination_members.any? %>
  <%# Step 2: Select recipient and amount %>
  <div class="row">
    <div class="col-md-8">
      <div class="card border-info">
        <div class="card-header bg-info text-white">
          <h2 class="h5 mb-0"><%= t("federation_hub.transfers.send_to", org: @selected_name) %></h2>
        </div>
        <div class="card-body">
          <% if flash[:alert].present? %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('federation_hub.common.close', default: 'Close') %>"></button>
            </div>
          <% end %>

          <%= form_tag(federation_hub_transfers_path, method: :post) do %>
            <input type="hidden" name="org_id" value="<%= @selected_id %>">
            <input type="hidden" name="source_type" value="<%= @selected_type %>">

            <%# Recipient %>
            <div class="mb-3">
              <label for="destination_member_id" class="form-label fw-bold"><%= t("federation_hub.transfers.recipient") %> <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (<%= t("federation_hub.common.required", default: "required") %>)</span></label>
              <select name="destination_member_id" id="destination_member_id" class="form-control" required aria-required="true">
                <option value=""><%= t("federation_hub.transfers.select_recipient") %></option>
                <% @destination_members.each do |m| %>
                  <option value="<%= m["id"] %>" <%= 'selected' if @pre_selected_member_id.to_s == m["id"].to_s %>><%= h(m["username"].to_s) %></option>
                <% end %>
              </select>
            </div>

            <%# Amount %>
            <fieldset class="mb-3">
              <legend class="form-label fw-bold"><%= t("federation_hub.transfers.amount") %> <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (<%= t("federation_hub.common.required", default: "required") %>)</span></legend>
              <div class="row">
                <div class="col-md-4">
                  <div class="input-group">
                    <label for="transfer_hours" class="visually-hidden"><%= t("federation_hub.transfers.hours") %></label>
                    <input type="number" name="hours" min="0" max="100" step="1" value="0" class="form-control" id="transfer_hours" required aria-required="true">
                    <span class="input-group-text"><%= t("federation_hub.transfers.hours") %></span>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="input-group">
                    <label for="transfer_minutes" class="visually-hidden"><%= t("federation_hub.transfers.minutes") %></label>
                    <input type="number" name="minutes" min="0" max="59" step="1" value="0" class="form-control" id="transfer_minutes">
                    <span class="input-group-text"><%= t("federation_hub.transfers.minutes") %></span>
                  </div>
                </div>
              </div>
            </fieldset>

            <%# Reason %>
            <div class="mb-3">
              <label for="reason" class="form-label fw-bold"><%= t("federation_hub.transfers.reason") %></label>
              <textarea name="reason" id="reason" class="form-control" rows="2" maxlength="500"
                        placeholder="<%= t("federation_hub.transfers.reason_placeholder") %>"></textarea>
            </div>

            <%# Your balance %>
            <div class="mb-3">
              <p class="text-muted">
                <%= t("federation_hub.transfers.your_balance") %>:
                <strong><%= format_federation_hours(current_member.account&.balance) %></strong>
              </p>
              <% if @selected_type == "external" %>
                <p class="text-muted small">
                  <%= t("federation_hub.transfers.external_note") %>
                </p>
              <% end %>
            </div>

            <button type="submit" class="btn btn-success btn-lg">
              <%= t("federation_hub.transfers.send_button") %>
            </button>
            <small id="balance-warning" class="text-danger d-none ms-3" data-balance="<%= current_member.account&.balance.to_i %>" data-warning-text="<%= t("federation_hub.transfers.exceeds_balance") %>"></small>
            <a href="<%= federation_hub_root_path %>" class="btn btn-outline-secondary btn-lg ms-2">
              <%= t("federation_hub.transfers.cancel") %>
            </a>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="alert alert-warning">
    <%= t("federation_hub.transfers.no_members", org: @selected_name) %>
  </div>
<% end %>

<script>
(function() {
  var hoursEl = document.getElementById('transfer_hours');
  var minsEl = document.getElementById('transfer_minutes');
  var warning = document.getElementById('balance-warning');
  if (!hoursEl || !minsEl || !warning) return;

  var balanceSeconds = parseInt(warning.getAttribute('data-balance'), 10) || 0;

  function checkBalance() {
    var hours = hoursEl ? parseInt(hoursEl.value, 10) || 0 : 0;
    var mins = minsEl ? parseInt(minsEl.value, 10) || 0 : 0;
    var amount = hours * 3600 + mins * 60;
    if (amount > 0 && amount > balanceSeconds) {
      warning.textContent = warning.getAttribute('data-warning-text');
      warning.classList.remove('d-none');
    } else {
      warning.classList.add('d-none');
    }
  }

  hoursEl.addEventListener('input', checkBalance);
  minsEl.addEventListener('input', checkBalance);

  // M13: Single confirmation handler (no duplicate data-confirm attribute on the button)
  var form = hoursEl.closest('form');
  if (form) {
    form.addEventListener('submit', function(e) {
      if (!confirm('<%= j t("federation_hub.transfers.confirm_send") %>')) {
        e.preventDefault();
      }
    });
  }
})();
</script>
