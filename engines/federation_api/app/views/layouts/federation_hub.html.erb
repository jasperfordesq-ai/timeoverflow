<%# DESIGN SYSTEM: Bootstrap 5 (matches host TimeOverflow app)
    The member-facing Hub uses Bootstrap 5 to match the host app's UI,
    ensuring a consistent experience for members. The admin panel uses
    Tailwind CSS in a separate layout — this is intentional. See the
    federation_admin layout for details. Do not attempt to unify them. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta content="IE=Edge,chrome=1" http-equiv="X-UA-Compatible">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title><%= content_for?(:title) ? "#{yield(:title)} - TimeOverflow" : "Federation Hub - TimeOverflow" %></title>
    <%= csrf_meta_tags %>
    <link href="/favicon.ico" rel="shortcut icon">
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <link href="https://fonts.googleapis.com/css?family=Work+Sans:400,500,600,700" rel="stylesheet">
    <%= javascript_include_tag 'libs' %>
    <%= javascript_include_tag 'application' %>
    <script><%= raw File.read(FederationApi::Engine.root.join("app/assets/javascripts/federation_form_helpers.js")) rescue "" %></script>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <a href="#main-content" class="visually-hidden-focusable">Skip to main content</a>
    <noscript>
      <div class="alert alert-warning text-center mb-0">
        <small><%= t("federation_hub.layout.noscript_warning", default: "JavaScript is required for some Federation Hub features (transfers, live filtering).") %></small>
      </div>
    </noscript>
    <%# ALPHA development notice %>
    <div class="alert alert-warning text-center mb-0 rounded-0 py-1" role="alert">
      <small class="fw-bold"><%= t("federation_hub.layout.alpha_notice") %></small>
    </div>

    <%# Navbar — matches TimeOverflow's structure %>
    <nav class="navbar navbar-expand-md navbar-static-top navbar-dark mb-4 p-0" role="navigation">
      <div class="container-fluid">
        <div class="container">
          <div class="row align-content-center w-100">
            <div class="col-12 col-md-3 d-flex">
              <div class="navbar-header w-100 d-flex align-items-center">
                <a class="navbar-brand align-content-center" href="/">TimeOverflow</a>
                <button type="button" class="navbar-toggler collapsed ms-auto" data-bs-toggle="collapse" data-bs-target="#navbar-collapse" aria-expanded="false">
                  <span class="visually-hidden"><%= t("federation_hub.nav.toggle") %></span>
                  <span class="navbar-toggler-icon"></span>
                </button>
              </div>
            </div>
            <div class="col-12 col-md-9">
              <div id="navbar-collapse" class="collapse navbar-collapse border-top border-primary">
                <ul class="nav navbar-nav ms-auto">
                  <% if current_user %>
                    <li class="nav-item">
                      <span class="nav-link text-light"><%= current_user.email %></span>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" href="/">
                        &larr; <%= t("federation_hub.nav.back_to_app") %>
                      </a>
                    </li>
                  <% else %>
                    <li class="nav-item">
                      <a class="nav-link" href="/login"><%= t("federation_hub.nav.login") %></a>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <%# Federation Hub navigation pills — matches TimeOverflow's actions-menu %>
    <% if current_user && current_member %>
      <nav role="navigation" aria-label="<%= t('federation_hub.nav.hub_navigation', default: 'Federation Hub navigation') %>">
        <div class="container">
          <div class="row">
            <div class="col-12">
              <ul class="nav nav-pills actions-menu flex-wrap">
                <li class="nav-item">
                  <a class="nav-link <%= 'active' if request.path == federation_hub_root_path %>" href="<%= federation_hub_root_path %>">
                    <%= t("federation_hub.nav.dashboard") %>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= 'active' if request.path.start_with?(federation_hub_partners_path) %>" href="<%= federation_hub_partners_path %>">
                    <%= t("federation_hub.nav.partners") %>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= 'active' if request.path.start_with?(federation_hub_members_path) %>" href="<%= federation_hub_members_path %>">
                    <%= t("federation_hub.nav.members") %>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= 'active' if request.path.start_with?(federation_hub_listings_path) %>" href="<%= federation_hub_listings_path %>">
                    <%= t("federation_hub.nav.listings") %>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= 'active' if request.path.start_with?(new_federation_hub_transfer_path) %>" href="<%= new_federation_hub_transfer_path %>">
                    <%= t("federation_hub.nav.transfers") %>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= 'active' if request.path.start_with?(federation_hub_messages_path) %>" href="<%= federation_hub_messages_path %>">
                    <%= t("federation_hub.nav.messages") %>
                    <% if unread_message_count > 0 %>
                      <span class="badge bg-warning text-dark"><%= unread_message_count %></span>
                    <% end %>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link <%= 'active' if request.path == federation_hub_settings_path %>" href="<%= federation_hub_settings_path %>">
                    <%= t("federation_hub.nav.settings") %>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <div class="container content flex-grow-1" id="main-content">
      <%# Breadcrumbs %>
      <% if content_for?(:breadcrumbs) %>
        <nav aria-label="breadcrumb" class="mt-2 mb-3">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="<%= federation_hub_root_path %>"><%= t("federation_hub.nav.dashboard") %></a></li>
            <%= yield :breadcrumbs %>
          </ol>
        </nav>
      <% end %>

      <%# Flash messages — matches TimeOverflow pattern %>
      <% flash.each do |type, message| %>
        <% alert_css = case type.to_s
                       when "notice", "success" then "alert-success"
                       when "alert", "error", "danger" then "alert-danger"
                       when "warning" then "alert-warning"
                       else "alert-info"
                       end %>
        <div class="alert <%= alert_css %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('federation_hub.common.close', default: 'Close') %>"></button>
        </div>
      <% end %>

      <div class="container-fluid">
        <%= yield %>
      </div>
    </div>

    <%# Modal — matches TimeOverflow's structure %>
    <div class="modal fade" id="modal" aria-hidden="true" aria-labelledby="modal-title" role="dialog">
      <div class="modal-dialog" style="max-width: 500px;">
        <div class="modal-content"></div>
      </div>
    </div>

    <%# Footer — matches TimeOverflow's structure %>
    <footer class="footer mt-auto">
      <div class="container">
        <div class="row py-3">
          <div class="col-12 text-center">
            <small class="text-muted">
              <%= t("federation_hub.layout.powered_by") %>
              <a href="https://www.timeoverflow.org" target="_blank" rel="noopener noreferrer">TimeOverflow</a>
            </small>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
