<% content_for(:title, t('federation_admin.api_keys.new.title')) %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900"><%= t('federation_admin.api_keys.new.title') %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= t('federation_admin.api_keys.new.subtitle') %></p>
</div>

<div class="bg-white shadow rounded-lg p-6 max-w-2xl">
  <form action="<%= federation_admin_api_keys_path %>" method="post">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <div class="space-y-6">
      <!-- Name -->
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700"><%= t('federation_admin.api_keys.new.name') %> <span class="text-red-500">*</span></label>
        <input type="text" name="name" id="name" required
               placeholder="<%= t('federation_admin.api_keys.new.name_placeholder') %>"
               class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
        <p class="mt-1 text-xs text-gray-400"><%= t('federation_admin.api_keys.new.name_help') %></p>
      </div>

      <!-- Organization -->
      <div>
        <label for="organization_id" class="block text-sm font-medium text-gray-700"><%= t('federation_admin.api_keys.new.organization') %></label>
        <select name="organization_id" id="organization_id"
                class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
          <option value=""><%= t('federation_admin.api_keys.new.global') %></option>
          <% @organizations.each do |org| %>
            <option value="<%= org.id %>"><%= org.name %></option>
          <% end %>
        </select>
        <p class="mt-1 text-xs text-gray-400"><%= t('federation_admin.api_keys.new.organization_help') %></p>
      </div>

      <!-- Permissions -->
      <fieldset>
        <legend class="block text-sm font-medium text-gray-700 mb-2"><%= t('federation_admin.api_keys.new.permissions') %></legend>
        <div class="space-y-2">
          <label class="flex items-center">
            <input type="checkbox" name="permission_profiles" value="1" checked
                   class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
            <span class="ml-2 text-sm text-gray-700"><%= t('federation_admin.api_keys.new.profiles') %></span>
            <span class="ml-2 text-xs text-gray-400"><%= t('federation_admin.api_keys.new.profiles_help') %></span>
          </label>
          <label class="flex items-center">
            <input type="checkbox" name="permission_listings" value="1" checked
                   class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
            <span class="ml-2 text-sm text-gray-700"><%= t('federation_admin.api_keys.new.listings') %></span>
            <span class="ml-2 text-xs text-gray-400"><%= t('federation_admin.api_keys.new.listings_help') %></span>
          </label>
          <label class="flex items-center">
            <input type="checkbox" name="permission_transactions" value="1"
                   class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
            <span class="ml-2 text-sm text-gray-700"><%= t('federation_admin.api_keys.new.transactions') %></span>
            <span class="ml-2 text-xs text-gray-400"><%= t('federation_admin.api_keys.new.transactions_help') %></span>
          </label>
        </div>
      </fieldset>

      <!-- Expiry -->
      <div>
        <label for="expires_at" class="block text-sm font-medium text-gray-700"><%= t('federation_admin.api_keys.new.expires_at') %></label>
        <input type="date" name="expires_at" id="expires_at" min="<%= Date.tomorrow.to_s %>"
               class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
        <p class="mt-1 text-xs text-gray-400"><%= t('federation_admin.api_keys.new.expires_help') %></p>
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-8 flex items-center gap-3">
      <button type="submit"
              class="bg-federation-600 hover:bg-federation-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
        <%= t('federation_admin.api_keys.new.submit') %>
      </button>
      <a href="<%= federation_admin_api_keys_path %>"
         class="bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 font-medium py-2 px-4 rounded-md transition-colors">
        <%= t('federation_admin.api_keys.new.cancel') %>
      </a>
    </div>
  </form>
</div>
