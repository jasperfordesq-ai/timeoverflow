<% content_for(:title, "Federation Partners") %>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Federation Partners</h1>
    <p class="mt-1 text-sm text-gray-500">Manage external timebanking platforms connected to this instance.</p>
  </div>
  <div class="mt-4 sm:mt-0">
    <a href="<%= new_federation_admin_partner_path %>"
       class="inline-flex items-center bg-federation-600 hover:bg-federation-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
      + Register New Partner
    </a>
  </div>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <% if @partners.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Platform</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Protocol</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Level</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Endpoint</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Orgs</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Health</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @partners.each do |partner| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= partner.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 capitalize"><%= partner.platform_type %></td>
            <td class="px-6 py-4 whitespace-nowrap text-xs">
              <span class="inline-flex items-center rounded-full px-2 py-0.5 font-medium bg-federation-50 text-federation-700">
                <%= partner.protocol_type&.upcase || "REST" %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% status_colors = { "active" => "bg-green-100 text-green-800", "pending" => "bg-yellow-100 text-yellow-800", "suspended" => "bg-red-100 text-red-800", "terminated" => "bg-gray-100 text-gray-600" } %>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_colors[partner.status] || 'bg-gray-100 text-gray-600' %>">
                <%= partner.status.capitalize %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% level_colors = { 1 => "bg-gray-100 text-gray-700", 2 => "bg-blue-100 text-blue-800", 3 => "bg-purple-100 text-purple-800", 4 => "bg-federation-100 text-federation-800" } %>
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= level_colors[partner.partnership_level] %>">
                L<%= partner.partnership_level %> &middot; <%= partner.level_name %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono text-xs max-w-xs truncate" title="<%= partner.api_endpoint %>">
              <%= truncate(partner.api_endpoint, length: 40) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if partner.permitted_organization_ids.blank? || partner.permitted_organization_ids.empty? %>
                <span class="text-federation-600 font-medium">All</span>
              <% else %>
                <%= partner.permitted_organization_ids.size %>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if partner.consecutive_failures == 0 %>
                <span class="inline-block h-3 w-3 rounded-full bg-green-500" title="Healthy"></span>
              <% elsif partner.consecutive_failures < 5 %>
                <span class="inline-block h-3 w-3 rounded-full bg-yellow-500" title="<%= partner.consecutive_failures %> failures"></span>
              <% else %>
                <span class="inline-block h-3 w-3 rounded-full bg-red-500" title="<%= partner.consecutive_failures %> failures (suspended)"></span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
              <a href="<%= federation_admin_partner_path(partner) %>" class="text-federation-600 hover:text-federation-800">View</a>
              <a href="<%= edit_federation_admin_partner_path(partner) %>" class="text-gray-600 hover:text-gray-800">Edit</a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500">No federation partners have been registered yet.</p>
      <a href="<%= new_federation_admin_partner_path %>"
         class="mt-4 inline-flex items-center text-sm font-medium text-federation-600 hover:text-federation-800">
        Register your first partner
      </a>
    </div>
  <% end %>
</div>
