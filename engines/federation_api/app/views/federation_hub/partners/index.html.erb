<% content_for(:title) { t("federation_hub.partners.title") } %>

<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h1><%= t("federation_hub.partners.title") %></h1>
      <p class="text-muted"><%= t("federation_hub.partners.subtitle") %></p>
    </div>
  </div>

  <% if @internal_orgs.any? %>
    <h4 class="mb-3"><%= t("federation_hub.common.internal_orgs") %></h4>
    <div class="row mb-4">
      <% @internal_orgs.each do |org| %>
        <div class="col-md-4 mb-4">
          <div class="card card-info border-info h-100">
            <div class="card-header bg-info text-white">
              <strong><%= org.name %></strong>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <span class="badge bg-success"><%= t("federation_hub.partners.status_active") %></span>
                <span class="badge bg-primary">TimeOverflow</span>
              </div>
              <p class="text-muted mb-3"><%= t("federation_hub.partners.internal_desc", org: org.name) %></p>
              <table class="table table-sm table-borderless mb-0">
                <tbody>
                  <tr>
                    <td><%= t("federation_hub.partners.feature_profiles") %></td>
                    <td class="text-end"><%= federation_feature_icon(true) %></td>
                  </tr>
                  <tr>
                    <td><%= t("federation_hub.partners.feature_listings") %></td>
                    <td class="text-end"><%= federation_feature_icon(true) %></td>
                  </tr>
                  <tr>
                    <td><%= t("federation_hub.partners.feature_transfers") %></td>
                    <td class="text-end"><%= federation_feature_icon(true) %></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2">
              <a href="<%= federation_hub_members_path(partner_id: org.id, source_type: 'internal') %>" class="btn btn-info btn-sm"><%= t("federation_hub.nav.members") %></a>
              <a href="<%= federation_hub_listings_path(partner_id: org.id, source_type: 'internal') %>" class="btn btn-info btn-sm"><%= t("federation_hub.nav.listings") %></a>
              <a href="<%= new_federation_hub_transfer_path(org_id: org.id) %>" class="btn btn-success btn-sm"><%= t("federation_hub.nav.transfers") %></a>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @external_partners.any? %>
    <h4 class="mb-3"><%= t("federation_hub.common.external_partners") %></h4>
    <div class="row">
      <% @external_partners.each do |partner| %>
        <div class="col-md-4 mb-4">
          <div class="card card-info border-info h-100">
            <div class="card-header bg-info text-white">
              <strong><%= partner.name %></strong>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <%= federation_status_badge(partner.status) %>
                <%= partnership_level_badge(partner.partnership_level, partner.level_name) %>
              </div>
              <table class="table table-sm table-borderless mb-3">
                <tbody>
                  <tr>
                    <td><%= t("federation_hub.partners.feature_profiles") %></td>
                    <td class="text-end"><%= federation_feature_icon(partner.can_share_profiles?) %></td>
                  </tr>
                  <tr>
                    <td><%= t("federation_hub.partners.feature_listings") %></td>
                    <td class="text-end"><%= federation_feature_icon(partner.can_share_listings?) %></td>
                  </tr>
                  <tr>
                    <td><%= t("federation_hub.partners.feature_transfers") %></td>
                    <td class="text-end"><%= federation_feature_icon(partner.can_transact?) %></td>
                  </tr>
                </tbody>
              </table>
              <% if partner.last_health_check_at.present? %>
                <small class="text-muted d-block mb-3">
                  <%= t("federation_hub.partners.last_check", time: time_ago_in_words(partner.last_health_check_at)) %>
                </small>
              <% end %>
            </div>
            <div class="card-footer bg-transparent">
              <%= link_to t("federation_hub.partners.view_details"), federation_hub_partner_path(partner), class: "btn btn-info btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @internal_orgs.empty? && @external_partners.empty? %>
    <div class="row">
      <div class="col-md-8">
        <div class="alert alert-secondary">
          <%= t("federation_hub.partners.none_available") %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-3">
    <%= link_to t("federation_hub.nav.dashboard"), federation_hub_root_path, class: "btn btn-outline-secondary" %>
  </div>
</div>
