<% content_for(:title) { "Organization Federation Settings" } %>

<!-- Page header -->
<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">Organization Federation Settings</h1>
  <p class="mt-1 text-sm text-gray-500">Configure federation participation for each organization.</p>
</div>

<!-- Settings table -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Organization</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Federation Enabled</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Discoverable</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Allow Inbound</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Allow Outbound</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Share Listings</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Opted-in Members</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @organizations.each do |org| %>
          <% settings = @settings_map[org.id] %>
          <% fed_enabled = settings&.federation_enabled || false %>
          <% discoverable = settings&.discoverable_by_partners || false %>
          <% allow_in = settings&.allow_inbound_transfers || false %>
          <% allow_out = settings&.allow_outbound_transfers || false %>
          <% share_list = settings&.share_listings || false %>
          <% opted = @opted_in_counts[org.id] || 0 %>
          <% total = @total_member_counts[org.id] || 0 %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= org.name %></td>
            <td class="px-4 py-3 text-center">
              <% if fed_enabled %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Enabled</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Disabled</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <% if discoverable %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Yes</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">No</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <% if allow_in %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Yes</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">No</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <% if allow_out %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Yes</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">No</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <% if share_list %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Yes</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">No</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-center text-gray-700">
              <%= opted %> / <%= total %>
            </td>
            <td class="px-4 py-3 text-center">
              <a href="<%= edit_federation_admin_org_setting_path(org) %>"
                 class="inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 shadow-sm">
                Edit
              </a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
