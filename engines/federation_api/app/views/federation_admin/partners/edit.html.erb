<% content_for(:title, "Edit Partner: #{@partner.name}") %>

<div class="mb-8">
  <a href="<%= federation_admin_partner_path(@partner) %>" class="text-sm text-federation-600 hover:text-federation-800">&larr; Back to Partner</a>
  <h1 class="mt-2 text-2xl font-bold text-gray-900">Edit: <%= @partner.name %></h1>
</div>

<div class="bg-white shadow rounded-lg p-6 max-w-2xl">
  <form action="<%= federation_admin_partner_path(@partner) %>" method="post">
    <input type="hidden" name="_method" value="patch">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token rescue "" %>

    <div class="space-y-6">
      <!-- Name -->
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
        <input type="text" name="name" id="name" required
               value="<%= @partner.name %>"
               class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
      </div>

      <!-- Platform Type -->
      <div>
        <label for="platform_type" class="block text-sm font-medium text-gray-700">Platform Type</label>
        <select name="platform_type" id="platform_type" required
                class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
          <% FederationPartner::PLATFORM_TYPES.each do |pt| %>
            <option value="<%= pt %>" <%= 'selected' if @partner.platform_type == pt %>><%= pt.capitalize %></option>
          <% end %>
        </select>
      </div>

      <!-- Status -->
      <div>
        <label for="status" class="block text-sm font-medium text-gray-700">Status</label>
        <select name="status" id="status" required
                class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
          <% FederationPartner::STATUSES.each do |s| %>
            <option value="<%= s %>" <%= 'selected' if @partner.status == s %>><%= s.capitalize %></option>
          <% end %>
        </select>
      </div>

      <!-- API Endpoint -->
      <div>
        <label for="api_endpoint" class="block text-sm font-medium text-gray-700">API Endpoint</label>
        <input type="url" name="api_endpoint" id="api_endpoint" required
               value="<%= @partner.api_endpoint %>"
               class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
      </div>

      <!-- Webhook URL -->
      <div>
        <label for="webhook_url" class="block text-sm font-medium text-gray-700">Webhook URL (optional)</label>
        <input type="url" name="webhook_url" id="webhook_url"
               value="<%= @partner.webhook_url %>"
               class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
      </div>

      <!-- Partnership Level -->
      <div>
        <label for="partnership_level" class="block text-sm font-medium text-gray-700">Partnership Level</label>
        <select name="partnership_level" id="partnership_level" required
                class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
          <option value="1" <%= 'selected' if @partner.partnership_level == 1 %>>Level 1 - Discovery (public metadata only)</option>
          <option value="2" <%= 'selected' if @partner.partnership_level == 2 %>>Level 2 - Social (profiles and messaging)</option>
          <option value="3" <%= 'selected' if @partner.partnership_level == 3 %>>Level 3 - Economic (cross-platform transfers)</option>
          <option value="4" <%= 'selected' if @partner.partnership_level == 4 %>>Level 4 - Integrated (full feature access)</option>
        </select>
      </div>

      <!-- Feature Gates -->
      <fieldset>
        <legend class="block text-sm font-medium text-gray-700 mb-2">Feature Gates</legend>
        <div class="space-y-2">
          <label class="flex items-center">
            <input type="checkbox" name="profiles_enabled" value="1"
                   <%= 'checked' if @partner.feature_gates&.dig("profiles_enabled") %>
                   class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
            <span class="ml-2 text-sm text-gray-700">Profiles Enabled</span>
            <span class="ml-2 text-xs text-gray-400">Share member profiles across platforms</span>
          </label>
          <label class="flex items-center">
            <input type="checkbox" name="listings_enabled" value="1"
                   <%= 'checked' if @partner.feature_gates&.dig("listings_enabled") %>
                   class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
            <span class="ml-2 text-sm text-gray-700">Listings Enabled</span>
            <span class="ml-2 text-xs text-gray-400">Share offers and inquiries</span>
          </label>
          <label class="flex items-center">
            <input type="checkbox" name="transactions_enabled" value="1"
                   <%= 'checked' if @partner.feature_gates&.dig("transactions_enabled") %>
                   class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
            <span class="ml-2 text-sm text-gray-700">Transactions Enabled</span>
            <span class="ml-2 text-xs text-gray-400">Allow cross-platform time transfers</span>
          </label>
          <label class="flex items-center">
            <input type="checkbox" name="messaging_enabled" value="1"
                   <%= 'checked' if @partner.feature_gates&.dig("messaging_enabled") %>
                   class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
            <span class="ml-2 text-sm text-gray-700">Messaging Enabled</span>
            <span class="ml-2 text-xs text-gray-400">Cross-platform member messaging</span>
          </label>
        </div>
      </fieldset>

      <!-- Permitted Organizations -->
      <fieldset>
        <legend class="block text-sm font-medium text-gray-700 mb-1">Permitted Organizations</legend>
        <p class="text-xs text-gray-400 mb-3">Select which organizations this partner can access. Leave all unchecked to allow access to all organizations.</p>
        <div class="max-h-48 overflow-y-auto border border-gray-200 rounded-md p-3 space-y-2">
          <% @organizations.each do |org| %>
            <label class="flex items-center">
              <input type="checkbox" name="permitted_organization_ids[]" value="<%= org.id %>"
                     <%= 'checked' if @partner.permitted_organization_ids&.include?(org.id) %>
                     class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
              <span class="ml-2 text-sm text-gray-700"><%= org.name %></span>
            </label>
          <% end %>
          <% if @organizations.empty? %>
            <p class="text-sm text-gray-400">No organizations found.</p>
          <% end %>
        </div>
      </fieldset>
    </div>

    <!-- Actions -->
    <div class="mt-8 flex items-center gap-3">
      <button type="submit"
              class="bg-federation-600 hover:bg-federation-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
        Update Partner
      </button>
      <a href="<%= federation_admin_partner_path(@partner) %>"
         class="bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 font-medium py-2 px-4 rounded-md transition-colors">
        Cancel
      </a>
    </div>
  </form>
</div>
