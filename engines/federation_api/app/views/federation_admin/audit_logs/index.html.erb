<% content_for(:title, "Audit Logs") %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">Audit Logs</h1>
  <p class="mt-1 text-sm text-gray-500">Record of administrative actions in the federation engine.</p>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <% if @logs.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actor</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Target</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Changes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @logs.each do |log| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-4 py-3 text-sm">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-federation-100 text-federation-800">
                  <%= log.action %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700"><%= log.actor_email || "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500 font-mono"><%= log.target_type %>#<%= log.target_id %></td>
              <td class="px-4 py-3 text-sm text-gray-400 font-mono"><%= log.ip_address || "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500">
                <% if log.changes_made.present? && log.changes_made.any? %>
                  <details>
                    <summary class="cursor-pointer text-federation-600 hover:text-federation-800"><%= log.changes_made.keys.count %> field(s)</summary>
                    <pre class="mt-1 text-xs bg-gray-50 p-2 rounded overflow-x-auto"><%= JSON.pretty_generate(log.changes_made) %></pre>
                  </details>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500">No audit logs recorded yet.</p>
    </div>
  <% end %>
</div>
