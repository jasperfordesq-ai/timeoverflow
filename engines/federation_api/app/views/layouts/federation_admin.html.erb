<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? "#{yield(:title)} — " : "" %>Federation Admin</title>
  <%# Production-ready: compiled Tailwind CSS + Rails UJS bundled inline.
      No external CDN dependencies. To regenerate CSS after view changes:
      cd engines/federation_api && npx tailwindcss -i ./app/assets/stylesheets/federation_admin_input.css -o ./app/assets/stylesheets/federation_admin.css --minify %>
  <style><%= File.read(FederationApi::Engine.root.join("app/assets/stylesheets/federation_admin.css")) rescue "/* CSS not found — run: cd engines/federation_api && npx tailwindcss ... */" %></style>
  <script><%= File.read(FederationApi::Engine.root.join("app/assets/javascripts/rails-ujs.min.js")) rescue "" %></script>
  <script>if (typeof Rails !== 'undefined') Rails.start();</script>
  <style>
    [data-flash] { animation: fadeOut 8s ease-in-out forwards; }
    @keyframes fadeOut { 0%,85% { opacity: 1; } 100% { opacity: 0; display: none; } }
  </style>
  <%= csrf_meta_tags %>
</head>
<body class="h-full">
  <div class="min-h-full">
    <!-- Alpha development notice -->
    <div class="bg-amber-500 text-amber-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2 text-center text-sm font-semibold">
        ALPHA &mdash; Federation Development Admin Panel &mdash; Not for production use
      </div>
    </div>
    <!-- Top navigation bar -->
    <nav class="bg-federation-800 shadow-lg">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0">
              <span class="text-2xl">🔗</span>
            </div>
            <a href="<%= federation_admin_root_path %>" class="text-white font-bold text-lg tracking-tight">
              Federation Admin
            </a>
            <span class="hidden sm:inline-block text-federation-300 text-xs font-mono bg-federation-900 px-2 py-0.5 rounded">
              v<%= FederationApi::VERSION %>
            </span>
          </div>

          <!-- Nav links -->
          <div class="hidden md:flex items-center space-x-1">
            <% nav_items = [
              [federation_admin_root_path, "Dashboard", "federation_admin_root"],
              [federation_admin_partners_path, "Partners", "partners"],
              [federation_admin_api_keys_path, "API Keys", "api_keys"],
              [federation_admin_transactions_path, "Transactions", "transactions"],
              [federation_admin_messages_path, "Messages", "messages"],
              [federation_admin_webhook_logs_path, "Webhooks", "webhook_logs"],
              [federation_admin_org_settings_path, "Org Settings", "org_settings"],
              [federation_admin_member_preferences_path, "Members", "member_preferences"],
              [federation_admin_activity_index_path, "Activity", "activity"]
            ] %>
            <% nav_items.each do |path, label, id| %>
              <% is_active = (path == federation_admin_root_path) ? (request.path == path) : request.path.start_with?(path) %>
              <a href="<%= path %>"
                 class="<%= is_active ? 'bg-federation-900 text-white' : 'text-federation-200 hover:bg-federation-700 hover:text-white' %> rounded-md px-3 py-2 text-sm font-medium transition-colors">
                <%= label %>
              </a>
            <% end %>
          </div>

          <form method="get" action="<%= federation_admin_transactions_path %>" class="hidden lg:flex items-center ml-4">
            <input type="text" name="search" placeholder="Search transactions..."
                   class="rounded-lg border border-federation-700 bg-federation-900 text-federation-200 text-sm px-3 py-1.5 w-40 placeholder-federation-400 focus:ring-federation-500 focus:border-federation-500 focus:bg-federation-800">
          </form>

          <div class="flex items-center gap-4">
            <% if federation_stats[:transactions_pending] > 0 %>
              <span class="inline-flex items-center rounded-full bg-yellow-400 px-2.5 py-0.5 text-xs font-semibold text-yellow-900">
                <%= federation_stats[:transactions_pending] %> pending
              </span>
            <% end %>
            <span class="text-federation-300 text-sm hidden lg:inline">
              <%= current_user&.username || current_user&.email %>
            </span>
            <a href="<%= main_app.root_path rescue '/' %>" class="text-federation-300 hover:text-white text-sm">
              ← Back to TimeOverflow
            </a>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div class="md:hidden border-t border-federation-700 px-4 py-2 flex flex-wrap gap-1">
        <% nav_items&.each do |path, label, _| %>
          <a href="<%= path %>" class="text-federation-200 hover:text-white text-sm px-2 py-1"><%= label %></a>
        <% end %>
      </div>
    </nav>

    <!-- Flash messages -->
    <% if flash[:notice] %>
      <div data-flash class="mx-auto max-w-7xl px-4 mt-4">
        <div class="rounded-md bg-green-50 border border-green-200 p-4">
          <p class="text-sm font-medium text-green-800"><%= flash[:notice] %></p>
        </div>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div data-flash class="mx-auto max-w-7xl px-4 mt-4">
        <div class="rounded-md bg-red-50 border border-red-200 p-4">
          <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
        </div>
      </div>
    <% end %>

    <!-- Main content -->
    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 mt-12">
      <div class="mx-auto max-w-7xl px-4 py-6 text-center text-xs text-gray-400">
        Federation Engine v<%= FederationApi::VERSION %> · Self-contained module · Does not modify TimeOverflow core
      </div>
    </footer>
  </div>
</body>
</html>
