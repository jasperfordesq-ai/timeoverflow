<% content_for(:title, "Webhook Log ##{@log.id}") %>

<%
  def status_badge_class(status)
    case status.to_s
    when "active", "completed", "success" then "bg-green-100 text-green-800"
    when "pending" then "bg-yellow-100 text-yellow-800"
    when "suspended", "cancelled" then "bg-gray-100 text-gray-800"
    when "terminated", "failed", "disputed" then "bg-red-100 text-red-800"
    else "bg-gray-100 text-gray-600"
    end
  end

  def direction_badge_class(direction)
    case direction.to_s
    when "inbound" then "bg-blue-100 text-blue-800"
    when "outbound" then "bg-purple-100 text-purple-800"
    else "bg-gray-100 text-gray-600"
    end
  end
%>

<div class="mb-6">
  <a href="<%= federation_admin_webhook_logs_path %>"
     class="inline-flex items-center text-sm font-medium text-federation-600 hover:text-federation-800">
    &larr; Back to Webhook Logs
  </a>
</div>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Webhook Log #<%= @log.id %></h1>
    <p class="mt-1 text-sm text-gray-500">Created <%= @log.created_at.strftime("%Y-%m-%d %H:%M:%S UTC") %></p>
  </div>
  <div class="mt-4 sm:mt-0">
    <span class="inline-flex items-center rounded-full px-4 py-1.5 text-sm font-semibold <%= status_badge_class(@log.status) %>">
      <%= @log.status %>
    </span>
  </div>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <div class="px-6 py-5 border-b border-gray-200">
    <h2 class="text-lg font-medium text-gray-900">Log Details</h2>
  </div>

  <dl class="divide-y divide-gray-200">
    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">ID</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono"><%= @log.id %></dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Partner</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
        <% if @log.federation_partner %>
          <a href="<%= federation_admin_partner_path(@log.federation_partner) %>"
             class="text-federation-600 hover:text-federation-800 font-medium">
            <%= @log.federation_partner.name %>
          </a>
        <% else %>
          <span class="text-gray-400">N/A</span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Event Type</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono"><%= @log.event_type %></dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Direction</dt>
      <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= direction_badge_class(@log.direction) %>">
          <%= @log.direction %>
        </span>
      </dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Status</dt>
      <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
        <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold <%= status_badge_class(@log.status) %>">
          <%= @log.status %>
        </span>
      </dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Response Code</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono"><%= @log.response_code || "-" %></dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Attempt Number</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @log.attempt_number || "-" %></dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Payload</dt>
      <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
        <% if @log.payload.present? %>
          <pre class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-xs font-mono"><%= @log.payload.is_a?(String) ? @log.payload : JSON.pretty_generate(@log.payload) %></pre>
        <% else %>
          <span class="text-gray-400">No payload</span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Response Body</dt>
      <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
        <% if @log.response_body.present? %>
          <pre class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-xs font-mono"><%= begin; JSON.pretty_generate(JSON.parse(@log.response_body)); rescue; @log.response_body; end %></pre>
        <% else %>
          <span class="text-gray-400">No response body</span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Created At</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @log.created_at.strftime("%Y-%m-%d %H:%M:%S UTC") %></dd>
    </div>

    <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-gray-500">Updated At</dt>
      <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @log.updated_at.strftime("%Y-%m-%d %H:%M:%S UTC") %></dd>
    </div>
  </dl>
</div>
