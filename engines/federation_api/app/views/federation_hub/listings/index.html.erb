<% content_for(:title) { t("federation_hub.listings.title") } %>

<div class="row">
  <div class="col-md-12">
    <h1><%= t("federation_hub.listings.title") %></h1>
    <p class="text-muted"><%= t("federation_hub.listings.subtitle") %></p>
  </div>
</div>

<%# Filters %>
<div class="row mb-4">
  <div class="col-md-8">
    <form method="get" action="<%= federation_hub_listings_path %>" class="d-flex flex-wrap gap-2" aria-label="<%= t('federation_hub.listings.filter_listings', default: 'Filter listings') %>">
      <label for="listings_partner_select" class="visually-hidden"><%= t("federation_hub.listings.select_partner") %></label>
      <select name="partner_id" id="listings_partner_select" class="form-control" aria-label="<%= t("federation_hub.listings.select_partner") %>" onchange="
        var opt = this.options[this.selectedIndex];
        document.getElementById('listings_source_type').value = opt.dataset.type || '';
        this.form.submit();
      ">
        <option value=""><%= t("federation_hub.listings.select_partner") %></option>

        <% if @internal_orgs.any? %>
          <optgroup label="<%= t("federation_hub.common.internal_orgs") %>">
            <% @internal_orgs.each do |org| %>
              <option value="<%= org.id %>"
                      data-type="internal"
                      <%= 'selected' if @selected_id.to_s == org.id.to_s && @selected_type == "internal" %>>
                <%= org.name %>
              </option>
            <% end %>
          </optgroup>
        <% end %>

        <% if @external_partners.any? %>
          <optgroup label="<%= t("federation_hub.common.external_partners") %>">
            <% @external_partners.each do |p| %>
              <option value="<%= p.id %>"
                      data-type="external"
                      <%= 'selected' if @selected_id.to_s == p.id.to_s && @selected_type != "internal" %>>
                <%= p.name %>
              </option>
            <% end %>
          </optgroup>
        <% end %>
      </select>
      <input type="hidden" name="source_type" id="listings_source_type" value="<%= @selected_type %>">

      <% if @selected_id.present? %>
        <label for="listings_type_filter" class="visually-hidden"><%= t("federation_hub.listings.all_types") %></label>
        <select name="type" id="listings_type_filter" class="form-control" data-auto-submit aria-label="<%= t("federation_hub.listings.all_types") %>">
          <option value=""><%= t("federation_hub.listings.all_types") %></option>
          <option value="offer" <%= 'selected' if params[:type] == 'offer' %>><%= t("federation_hub.listings.offers") %></option>
          <option value="inquiry" <%= 'selected' if params[:type] == 'inquiry' %>><%= t("federation_hub.listings.inquiries") %></option>
        </select>
        <label for="listings_search" class="visually-hidden"><%= t("federation_hub.listings.search") %></label>
        <input type="text" id="listings_search" name="q" value="<%= params[:q] %>" placeholder="<%= t("federation_hub.listings.search_placeholder") %>" class="form-control">
        <button type="submit" class="btn btn-info"><%= t("federation_hub.listings.search") %></button>
      <% end %>
    </form>
  </div>
</div>

<% if @selected_id.blank? %>
  <div class="alert alert-info">
    <%= t("federation_hub.listings.choose_partner") %>
  </div>
<% elsif @listings.any? %>
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0"><%= t("federation_hub.listings.source_label", source: @source_name) %></h2>
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <small class="text-muted"><%= t("federation_hub.listings.sort_by", default: "Sort:") %></small>
          <% sort_base = request.query_parameters.except("sort", "dir", "page") %>
          <% current_sort = params[:sort] %>
          <% current_dir = params[:dir] || "asc" %>
          <% [["title", t("federation_hub.listings.sort_title", default: "Title")],
              ["type", t("federation_hub.listings.sort_type", default: "Type")],
              ["user", t("federation_hub.listings.sort_user", default: "User")]].each do |key, label| %>
            <% next_dir = (current_sort == key && current_dir == "asc") ? "desc" : "asc" %>
            <a href="<%= federation_hub_listings_path(sort_base.merge(sort: key, dir: next_dir)) %>"
               class="btn btn-sm <%= current_sort == key ? 'btn-info' : 'btn-outline-secondary' %>">
              <%= label %><%= current_sort == key ? (current_dir == "asc" ? " ↑" : " ↓") : "" %>
            </a>
          <% end %>
        </div>
      </div>

      <% @listings.each do |listing| %>
        <div class="post mb-3 p-3 border rounded bg-white">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h3 class="h4 mb-1">
                <%= sanitize(listing["title"].to_s.presence || listing["name"].to_s.presence || t("federation_hub.listings.listing_fallback", id: listing["id"]), tags: []) %>
              </h3>
              <% if listing["description"].present? %>
                <% desc = listing["description"].to_s %>
                <% if desc.length > 200 %>
                  <p class="text-muted mb-2">
                    <span class="listing-desc-short"><%= sanitize(truncate(desc, length: 200), tags: []) %>
                      <button type="button" class="btn btn-link text-info p-0 align-baseline listing-expand" aria-expanded="false"><%= t("federation_hub.listings.read_more", default: "Read more") %></button>
                    </span>
                    <span class="listing-desc-full" style="display:none"><%= simple_format(sanitize(desc, tags: []), {}, wrapper_tag: "span") %>
                      <button type="button" class="btn btn-link text-info p-0 align-baseline listing-collapse" aria-expanded="true"><%= t("federation_hub.listings.read_less", default: "Show less") %></button>
                    </span>
                  </p>
                <% else %>
                  <p class="text-muted mb-2"><%= simple_format(sanitize(desc, tags: []), {}, wrapper_tag: "span") %></p>
                <% end %>
              <% end %>
              <div class="d-flex flex-wrap gap-1">
                <% if listing["type"] %>
                  <span class="badge rounded-pill <%= listing["type"].to_s.downcase == "offer" ? "bg-success" : "bg-warning text-dark" %>">
                    <%= sanitize(listing["type"].to_s.capitalize, tags: []) %>
                  </span>
                <% end %>
                <% if listing["category"].present? %>
                  <span class="badge rounded-pill bg-info"><%= sanitize(listing["category"].to_s, tags: []) %></span>
                <% end %>
                <% tags = listing["tags"] %>
                <% tags = tags.split(",").map(&:strip) if tags.is_a?(String) %>
                <% Array(tags).first(5).each do |tag| %>
                  <% next if tag.blank? %>
                  <span class="badge rounded-pill bg-secondary"><%= sanitize(tag.to_s, tags: []) %></span>
                <% end %>
              </div>
            </div>
            <% if listing["user"].present? %>
              <small class="text-muted ms-3 text-nowrap"><%= sanitize(listing["user"].to_s, tags: []) %></small>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @total_pages > 1 %>
      <div class="d-flex justify-content-between align-items-center mt-3 px-3 pb-3">
        <small class="text-muted"><%= t("federation_hub.common.page") %> <%= @current_page %> / <%= @total_pages %> (<%= @total_count %> <%= t("federation_hub.listings.total", default: "total") %>)</small>
        <nav aria-label="<%= t('federation_hub.common.pagination', default: 'Pagination') %>">
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= 'disabled' if @current_page <= 1 %>">
              <a class="page-link" href="<%= federation_hub_listings_path(request.query_parameters.merge(page: @current_page - 1)) %>"><%= t("federation_hub.common.previous", default: "Previous") %></a>
            </li>
            <li class="page-item <%= 'disabled' if @current_page >= @total_pages %>">
              <a class="page-link" href="<%= federation_hub_listings_path(request.query_parameters.merge(page: @current_page + 1)) %>"><%= t("federation_hub.common.next_page", default: "Next") %></a>
            </li>
          </ul>
        </nav>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    <%= t("federation_hub.listings.none_found", partner: @source_name) %>
  </div>
<% end %>
