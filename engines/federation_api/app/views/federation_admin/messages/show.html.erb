<% content_for(:title) { t('federation_admin.messages.show.title', id: @message.id) } %>

<!-- Page header -->
<div class="mb-8">
  <a href="<%= federation_admin_messages_path %>" class="inline-flex items-center text-sm text-federation-600 hover:text-federation-900 mb-3">
    <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    <%= t('federation_admin.messages.show.back') %>
  </a>
  <h1 class="text-2xl font-bold text-gray-900"><%= t('federation_admin.messages.show.title', id: @message.id) %></h1>
</div>

<!-- Message detail card -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
    <h2 class="text-lg font-semibold text-gray-900"><%= t('federation_admin.messages.show.details_title') %></h2>
  </div>

  <dl class="divide-y divide-gray-200">
    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.id') %></dt>
      <dd class="text-sm text-gray-900 col-span-2 font-mono"><%= @message.id %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.partner') %></dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.federation_partner&.name || 'N/A' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.direction') %></dt>
      <dd class="text-sm col-span-2">
        <% if @message.direction == 'inbound' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"><%= t('federation_admin.messages.show.inbound') %></span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= t('federation_admin.messages.show.outbound') %></span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.remote_user') %></dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.remote_user_identifier || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.local_member_id') %></dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.local_member_id || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.organization_id') %></dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.organization_id || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.subject') %></dt>
      <dd class="text-sm text-gray-900 col-span-2 font-medium"><%= @message.subject || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.body') %></dt>
      <dd class="text-sm text-gray-900 col-span-2">
        <% if @message.body.present? %>
          <div class="bg-gray-50 rounded-lg border border-gray-200 p-4 whitespace-pre-wrap font-mono text-xs leading-relaxed"><%= @message.body %></div>
        <% else %>
          <span class="text-gray-400"><%= t('federation_admin.messages.show.no_body') %></span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.status') %></dt>
      <dd class="text-sm col-span-2">
        <% case @message.status %>
        <% when 'pending' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800"><%= t('federation_admin.messages.show.pending') %></span>
        <% when 'delivered' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"><%= t('federation_admin.messages.show.delivered') %></span>
        <% when 'read' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-federation-100 text-federation-800"><%= t('federation_admin.messages.show.read') %></span>
        <% when 'failed' %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800"><%= t('federation_admin.messages.show.failed') %></span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"><%= @message.status %></span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.external_id') %></dt>
      <dd class="text-sm text-gray-900 col-span-2 font-mono"><%= @message.external_message_id || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.delivered_at') %></dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.delivered_at&.then { |t| format_date(t) } || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.read_at') %></dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.read_at&.then { |t| format_date(t) } || '-' %></dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.metadata') %></dt>
      <dd class="text-sm text-gray-900 col-span-2">
        <% if @message.metadata.present? %>
          <div class="bg-gray-50 rounded-lg border border-gray-200 p-4 font-mono text-xs leading-relaxed"><%= h(JSON.pretty_generate(@message.metadata)) %></div>
        <% else %>
          <span class="text-gray-400"><%= t('federation_admin.messages.show.none') %></span>
        <% end %>
      </dd>
    </div>

    <div class="px-6 py-4 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500"><%= t('federation_admin.messages.show.created_at') %></dt>
      <dd class="text-sm text-gray-900 col-span-2"><%= @message.created_at.then { |t| format_date(t) } %></dd>
    </div>
  </dl>
</div>
