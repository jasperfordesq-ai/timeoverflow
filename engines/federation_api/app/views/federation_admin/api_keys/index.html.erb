<% content_for(:title, "API Keys") %>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">API Keys</h1>
    <p class="mt-1 text-sm text-gray-500">Manage authentication keys for federation partners.</p>
  </div>
  <div class="mt-4 sm:mt-0">
    <a href="<%= new_federation_admin_api_key_path %>"
       class="inline-flex items-center bg-federation-600 hover:bg-federation-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
      + Generate New Key
    </a>
  </div>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <% if @api_keys.any? %>
    <form method="post" action="<%= bulk_revoke_federation_admin_api_keys_path %>" id="bulk-revoke-form">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div class="px-6 py-3 bg-gray-50 border-b border-gray-200 flex items-center gap-3">
        <button type="submit" class="inline-flex items-center gap-1.5 rounded-md bg-red-600 hover:bg-red-700 text-white font-medium py-1.5 px-3 text-sm transition-colors disabled:opacity-50"
                onclick="return confirm('Revoke all selected API keys? This cannot be undone.')">
          Revoke Selected
        </button>
        <span class="text-xs text-gray-500">Select keys using the checkboxes below</span>
      </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <input type="checkbox" id="select-all-keys" class="rounded border-gray-300"
                   onchange="document.querySelectorAll('.key-checkbox').forEach(c => c.checked = this.checked)">
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prefix</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Organization</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Permissions</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Used</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expires</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @api_keys.each do |key| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <input type="checkbox" name="ids[]" value="<%= key.id %>" class="key-checkbox rounded border-gray-300">
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-900"><%= key.key_prefix %>...</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= key.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= key.organization&.name || '<span class="text-federation-600 font-medium">Global</span>'.html_safe %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <% if key.permissions.present? %>
                <% key.permissions.select { |_, v| v }.each do |perm, _| %>
                  <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800 mr-1">
                    <%= perm %>
                  </span>
                <% end %>
              <% else %>
                <span class="text-gray-400 text-xs">All</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= key.last_used_at&.strftime("%Y-%m-%d %H:%M") || "Never" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <% if key.expires_at.present? %>
                <span class="<%= key.expired? ? 'text-red-600' : '' %>">
                  <%= key.expires_at.strftime("%Y-%m-%d") %>
                </span>
              <% else %>
                <span class="text-gray-400">Never</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if key.active && !key.expired? %>
                <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Active</span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600">Revoked</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
              <a href="<%= federation_admin_api_key_path(key) %>" class="text-federation-600 hover:text-federation-800">View</a>
              <% if key.active && !key.expired? %>
                <a href="<%= federation_admin_api_key_path(key) %>"
                   data-method="delete"
                   data-confirm="Are you sure you want to revoke this API key? This action cannot be undone."
                   class="text-red-600 hover:text-red-800">Revoke</a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </form>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500">No API keys have been created yet.</p>
      <a href="<%= new_federation_admin_api_key_path %>"
         class="mt-4 inline-flex items-center text-sm font-medium text-federation-600 hover:text-federation-800">
        Generate your first key
      </a>
    </div>
  <% end %>
</div>
