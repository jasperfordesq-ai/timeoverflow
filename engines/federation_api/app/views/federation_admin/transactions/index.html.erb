<% content_for(:title, t('federation_admin.transactions.index.title')) %>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= t('federation_admin.transactions.index.title') %></h1>
    <p class="mt-1 text-sm text-gray-500"><%= @total_count %> <%= t('federation_admin.transactions.index.total') %></p>
  </div>
  <div class="mt-4 sm:mt-0">
    <a href="<%= export_federation_admin_transactions_path(request.query_parameters) %>"
       class="inline-flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
      <%= t('federation_admin.transactions.index.export_csv') %>
    </a>
  </div>
</div>

<!-- Filter Bar -->
<div class="bg-white shadow rounded-lg p-4 mb-6">
  <form method="get" action="<%= federation_admin_transactions_path %>" class="flex flex-wrap items-end gap-4">
    <div>
      <label for="search" class="block text-xs font-medium text-gray-500 mb-1"><%= t('federation_admin.transactions.index.search_placeholder') %></label>
      <input type="text" name="search" id="search" value="<%= params[:search] %>" placeholder="<%= t('federation_admin.transactions.index.search_placeholder') %>"
             class="rounded-lg border border-gray-300 text-sm px-3 py-2 w-48 focus:ring-federation-500 focus:border-federation-500">
    </div>

    <div>
      <label for="status" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1"><%= t('federation_admin.transactions.index.table.status') %></label>
      <select name="status" id="status" data-auto-submit
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value=""><%= t('federation_admin.transactions.index.all_statuses') %></option>
        <% %w[pending completed cancelled disputed].each do |s| %>
          <option value="<%= s %>" <%= params[:status] == s ? 'selected' : '' %>><%= t("federation_admin.common.#{s}") %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="direction" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1"><%= t('federation_admin.transactions.index.table.direction') %></label>
      <select name="direction" id="direction" data-auto-submit
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value=""><%= t('federation_admin.transactions.index.all_directions') %></option>
        <% %w[inbound outbound].each do |d| %>
          <option value="<%= d %>" <%= params[:direction] == d ? 'selected' : '' %>><%= t("federation_admin.common.#{d}") %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="partner_id" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1"><%= t('federation_admin.transactions.index.table.partner') %></label>
      <select name="partner_id" id="partner_id" data-auto-submit
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value=""><%= t('federation_admin.transactions.index.all_partners') %></option>
        <% @partners.each do |partner| %>
          <option value="<%= partner.id %>" <%= params[:partner_id].to_s == partner.id.to_s ? 'selected' : '' %>><%= partner.name %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="organization_id" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1"><%= t('federation_admin.transactions.index.organization') %></label>
      <select name="organization_id" id="organization_id" data-auto-submit
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value=""><%= t('federation_admin.transactions.index.all_organizations') %></option>
        <% @organizations.each do |org| %>
          <option value="<%= org.id %>" <%= params[:organization_id].to_s == org.id.to_s ? 'selected' : '' %>><%= org.name %></option>
        <% end %>
      </select>
    </div>

    <div>
      <button type="submit" class="inline-flex items-center rounded-md bg-federation-600 px-3 py-2 text-sm font-medium text-white hover:bg-federation-700">
        <%= t('federation_admin.transactions.index.search') %>
      </button>
    </div>

    <% if params[:status].present? || params[:direction].present? || params[:partner_id].present? || params[:organization_id].present? || params[:search].present? %>
      <div>
        <a href="<%= federation_admin_transactions_path %>"
           class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700">
          <%= t('federation_admin.transactions.index.clear_filters') %>
        </a>
      </div>
    <% end %>
  </form>
</div>

<!-- Table -->
<div class="bg-white shadow rounded-lg overflow-hidden">
  <% if @transactions.any? %>
    <div class="overflow-x-auto scroll-shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <caption class="sr-only"><%= t('federation_admin.transactions.index.title') %></caption>
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link(t('federation_admin.transactions.index.table.id'), "id", params[:sort], params[:dir]) %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('federation_admin.transactions.index.table.external_id') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('federation_admin.transactions.index.table.partner') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('federation_admin.transactions.index.table.org_id') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link(t('federation_admin.transactions.index.table.direction'), "direction", params[:sort], params[:dir]) %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link(t('federation_admin.transactions.index.table.amount'), "amount", params[:sort], params[:dir]) %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link(t('federation_admin.transactions.index.table.status'), "status", params[:sort], params[:dir]) %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('federation_admin.transactions.index.table.transfer_id') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= sort_link(t('federation_admin.transactions.index.table.created_at'), "created_at", params[:sort], params[:dir]) %></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @transactions.each do |txn| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap font-mono">
                <a href="<%= federation_admin_transaction_path(txn) %>" class="text-federation-600 hover:text-federation-800"><%= txn.id %></a>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap font-mono" title="<%= txn.external_transaction_id %>">
                <%= truncate(txn.external_transaction_id.to_s, length: 16) %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
                <%= txn.federation_partner&.name || "N/A" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= txn.organization_id %></td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= direction_badge_class(txn.direction) %>">
                  <%= txn.direction %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap font-medium">
                <%= (txn.amount.to_f / 3600).round(2) %>h
              </td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_badge_class(txn.status) %>">
                  <%= txn.status %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap font-mono"><%= txn.transfer_id || "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= format_date(txn.created_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3 mt-4">
      <div class="text-sm text-gray-700">
        <%= t('federation_admin.transactions.index.page') %> <span class="font-medium"><%= @current_page %></span> <%= t('federation_admin.transactions.index.of') %> <span class="font-medium"><%= @total_pages %></span>
      </div>
      <div class="flex space-x-2">
        <% if @current_page > 1 %>
          <a href="<%= federation_admin_transactions_path(request.query_parameters.merge(page: @current_page - 1)) %>"
             class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            <%= t('federation_admin.transactions.index.previous') %>
          </a>
        <% else %>
          <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 opacity-50 cursor-not-allowed">
            <%= t('federation_admin.transactions.index.previous') %>
          </span>
        <% end %>

        <% if @current_page < @total_pages %>
          <a href="<%= federation_admin_transactions_path(request.query_parameters.merge(page: @current_page + 1)) %>"
             class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            <%= t('federation_admin.transactions.index.next') %>
          </a>
        <% else %>
          <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 opacity-50 cursor-not-allowed">
            <%= t('federation_admin.transactions.index.next') %>
          </span>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500"><%= t('federation_admin.transactions.index.empty') %></p>
    </div>
  <% end %>
</div>
