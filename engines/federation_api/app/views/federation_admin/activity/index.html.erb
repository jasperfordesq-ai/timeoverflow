<% content_for(:title, t('federation_admin.activity.title')) %>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= t('federation_admin.activity.title') %></h1>
    <p class="mt-1 text-sm text-gray-500"><%= t('federation_admin.activity.subtitle') %> (<%= @events.size %> events)</p>
  </div>
</div>

<% if @events.any? %>
  <div class="relative">
    <!-- Vertical timeline line -->
    <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-200"></div>

    <div class="space-y-4">
      <% @events.each do |event| %>
        <a href="<%= event[:link] %>" class="block relative pl-16 group">
          <!-- Timeline dot -->
          <div class="absolute left-4 top-5 w-4 h-4 rounded-full border-2 border-white shadow
            <%= case event[:type]
                when 'transaction' then 'bg-federation-500'
                when 'message' then 'bg-purple-500'
                when 'webhook' then 'bg-amber-500'
                else 'bg-gray-400'
                end %>">
          </div>

          <div class="bg-white shadow rounded-lg p-4 group-hover:shadow-md transition-shadow">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div class="flex-1 min-w-0">
                <!-- Icon + Title -->
                <div class="flex items-center gap-2">
                  <% case event[:icon] %>
                  <% when "arrow-down" %>
                    <svg class="h-4 w-4 text-green-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" role="img" aria-label="Inbound transfer">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                    </svg>
                  <% when "arrow-up" %>
                    <svg class="h-4 w-4 text-blue-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" role="img" aria-label="Outbound transfer">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
                    </svg>
                  <% when "mail-in" %>
                    <svg class="h-4 w-4 text-purple-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" role="img" aria-label="Inbound message">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                  <% when "mail-out" %>
                    <svg class="h-4 w-4 text-indigo-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" role="img" aria-label="Outbound message">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                    </svg>
                  <% when "bell" %>
                    <svg class="h-4 w-4 text-amber-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" role="img" aria-label="Webhook notification">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                    </svg>
                  <% when "broadcast" %>
                    <svg class="h-4 w-4 text-orange-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" role="img" aria-label="Broadcast event">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.348 14.651a3.75 3.75 0 010-5.303m5.304 0a3.75 3.75 0 010 5.303m-7.425 2.122a6.75 6.75 0 010-9.546m9.546 0a6.75 6.75 0 010 9.546M5.106 18.894c-3.808-3.808-3.808-9.98 0-13.789m13.788 0c3.808 3.808 3.808 9.981 0 13.79M12 12h.008v.007H12V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                    </svg>
                  <% end %>
                  <span class="text-sm font-semibold text-gray-900"><%= event[:title] %></span>
                </div>

                <!-- Subtitle -->
                <p class="mt-1 text-xs text-gray-500"><%= event[:subtitle] %></p>
              </div>

              <div class="flex items-center gap-3 flex-shrink-0">
                <!-- Status badge -->
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_badge_class(event[:status]) %>">
                  <%= event[:status] %>
                </span>

                <!-- Type badge -->
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                  <%= case event[:type]
                      when 'transaction' then 'bg-federation-100 text-federation-800'
                      when 'message' then 'bg-purple-100 text-purple-800'
                      when 'webhook' then 'bg-amber-100 text-amber-800'
                      else 'bg-gray-100 text-gray-600'
                      end %>">
                  <%= event[:type].capitalize %>
                </span>
              </div>
            </div>

            <!-- Timestamp -->
            <div class="mt-2 text-xs text-gray-400">
              <%= format_date(event[:timestamp]) %>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" role="img" aria-label="Clock icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-gray-900"><%= t('federation_admin.activity.empty') %></h3>
      <p class="mt-1 text-sm text-gray-500"><%= t('federation_admin.activity.empty_detail') %></p>
    </div>
  </div>
<% end %>
