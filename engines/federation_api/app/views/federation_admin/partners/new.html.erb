<% content_for(:title, t("federation_admin.partners.new.title")) %>

<div class="mb-8">
  <a href="<%= federation_admin_partners_path %>" class="text-sm text-federation-600 hover:text-federation-800">&larr; <%= t("federation_admin.partners.new.back") %></a>
  <h1 class="mt-2 text-2xl font-bold text-gray-900"><%= t("federation_admin.partners.new.title") %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= t("federation_admin.partners.new.subtitle") %></p>
</div>

<div class="max-w-2xl">
  <form action="<%= federation_admin_partners_path %>" method="post">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <% if @partner.errors.any? %>
      <div class="rounded-md bg-red-50 p-4 mb-6">
        <ul class="list-disc pl-5 text-sm text-red-700">
          <% @partner.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# ── Section 1: Connection Details ── %>
    <div class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1"><%= t("federation_admin.partners.new.section_connection", default: "Connection Details") %></h2>
      <p class="text-sm text-gray-500 mb-5"><%= t("federation_admin.partners.new.section_connection_help", default: "How this TimeOverflow instance connects to the partner platform.") %></p>

      <div class="space-y-5">
        <!-- Name -->
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700"><%= t("federation_admin.partners.new.name") %></label>
          <input type="text" name="name" id="name" required
                 value="<%= @partner&.name %>"
                 placeholder="<%= t("federation_admin.partners.new.name_placeholder") %>"
                 class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
        </div>

        <!-- Platform + Protocol (side by side) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="platform_type" class="block text-sm font-medium text-gray-700"><%= t("federation_admin.partners.new.platform_type") %></label>
            <select name="platform_type" id="platform_type" required
                    class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
              <option value="nexus" <%= 'selected' if @partner&.platform_type == "nexus" %>><%= t("federation_admin.common.platform_types.nexus") %></option>
              <option value="timeoverflow" <%= 'selected' if @partner&.platform_type == "timeoverflow" %>><%= t("federation_admin.common.platform_types.timeoverflow") %></option>
              <option value="komunitin" <%= 'selected' if @partner&.platform_type == "komunitin" %>><%= t("federation_admin.common.platform_types.komunitin") %></option>
              <option value="custom" <%= 'selected' if @partner&.platform_type == "custom" %>><%= t("federation_admin.common.platform_types.custom") %></option>
            </select>
          </div>
          <div>
            <label for="protocol_type" class="block text-sm font-medium text-gray-700"><%= t("federation_admin.partners.new.protocol_type") %></label>
            <select name="protocol_type" id="protocol_type" required
                    class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
              <% Federation::Adapters.protocol_labels.each do |value, label| %>
                <option value="<%= value %>" <%= 'selected' if @partner&.protocol_type == value %>><%= label %></option>
              <% end %>
            </select>
            <p class="mt-1 text-xs text-gray-400"><%= t("federation_admin.partners.new.protocol_help") %></p>
          </div>
        </div>

        <!-- API Endpoint -->
        <div>
          <label for="api_endpoint" class="block text-sm font-medium text-gray-700"><%= t("federation_admin.partners.new.api_endpoint") %></label>
          <input type="url" name="api_endpoint" id="api_endpoint" required
                 value="<%= @partner&.api_endpoint %>"
                 placeholder="<%= t("federation_admin.partners.new.api_endpoint_placeholder") %>"
                 class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
          <p class="mt-1 text-xs text-gray-400"><%= t("federation_admin.partners.new.api_endpoint_help") %></p>
        </div>

        <!-- Browse Base URL + Webhook URL (side by side) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="browse_base_url" class="block text-sm font-medium text-gray-700"><%= t("federation_admin.partners.new.browse_base_url") %></label>
            <input type="url" name="browse_base_url" id="browse_base_url"
                   value="<%= @partner&.browse_base_url %>"
                   placeholder="<%= t("federation_admin.partners.new.browse_base_url_placeholder") %>"
                   class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
            <p class="mt-1 text-xs text-gray-400"><%= t("federation_admin.partners.new.browse_base_url_help") %></p>
          </div>
          <div>
            <label for="webhook_url" class="block text-sm font-medium text-gray-700"><%= t("federation_admin.partners.new.webhook_url") %></label>
            <input type="url" name="webhook_url" id="webhook_url"
                   value="<%= @partner&.webhook_url %>"
                   placeholder="<%= t("federation_admin.partners.new.webhook_url_placeholder") %>"
                   class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
            <p class="mt-1 text-xs text-gray-400"><%= t("federation_admin.partners.new.webhook_url_help") %></p>
          </div>
        </div>

        <!-- Partner API Key -->
        <div>
          <label for="api_key_hash" class="block text-sm font-medium text-gray-700"><%= t("federation_admin.partners.new.partner_api_key", default: "Partner API Key") %></label>
          <input type="text" name="api_key_hash" id="api_key_hash"
                 value=""
                 placeholder="<%= t("federation_admin.partners.new.partner_api_key_placeholder", default: "Paste the API key provided by the partner") %>"
                 class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2 font-mono">
          <p class="mt-1 text-xs text-gray-400"><%= t("federation_admin.partners.new.partner_api_key_help", default: "The API key used to authenticate when calling the partner's API. Leave blank to auto-generate.") %></p>
        </div>
      </div>
    </div>

    <%# ── Section 2: Access Control ── %>
    <div class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1"><%= t("federation_admin.partners.new.section_access", default: "Access Control") %></h2>
      <p class="text-sm text-gray-500 mb-5"><%= t("federation_admin.partners.new.section_access_help", default: "Partnership level and which organizations this partner can access.") %></p>

      <div class="space-y-5">
        <!-- Partnership Level -->
        <div>
          <label for="partnership_level" class="block text-sm font-medium text-gray-700"><%= t("federation_admin.partners.new.partnership_level") %></label>
          <select name="partnership_level" id="partnership_level" required
                  class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-federation-500 focus:ring-federation-500 sm:text-sm px-3 py-2">
            <option value="1" <%= 'selected' if @partner&.partnership_level.to_i == 1 %>><%= t("federation_admin.partners.new.levels.discovery") %></option>
            <option value="2" <%= 'selected' if @partner&.partnership_level.to_i == 2 %>><%= t("federation_admin.partners.new.levels.social") %></option>
            <option value="3" <%= 'selected' if @partner&.partnership_level.to_i == 3 %>><%= t("federation_admin.partners.new.levels.economic") %></option>
            <option value="4" <%= 'selected' if @partner&.partnership_level.to_i == 4 %>><%= t("federation_admin.partners.new.levels.integrated") %></option>
          </select>
        </div>

        <!-- Permitted Organizations -->
        <fieldset>
          <legend class="block text-sm font-medium text-gray-700 mb-1"><%= t("federation_admin.partners.new.permitted_orgs") %></legend>
          <p class="text-xs text-gray-400 mb-3"><%= t("federation_admin.partners.new.permitted_orgs_help") %></p>
          <div class="max-h-48 overflow-y-auto border border-gray-200 rounded-md p-3 space-y-2">
            <% @organizations.each do |org| %>
              <label class="flex items-center">
                <input type="checkbox" name="permitted_organization_ids[]" value="<%= org.id %>"
                       class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
                <span class="ml-2 text-sm text-gray-700"><%= org.name %></span>
              </label>
            <% end %>
            <% if @organizations.empty? %>
              <p class="text-sm text-gray-400"><%= t("federation_admin.partners.new.no_orgs") %></p>
            <% end %>
          </div>
        </fieldset>
      </div>
    </div>

    <%# ── Section 3: Feature Gates ── %>
    <div class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1"><%= t("federation_admin.partners.new.feature_gates") %></h2>
      <p class="text-sm text-gray-500 mb-5"><%= t("federation_admin.partners.new.section_features_help", default: "Enable or disable specific federation capabilities for this partner.") %></p>

      <div class="space-y-3">
        <label class="flex items-center">
          <input type="hidden" name="profiles_enabled" value="0">
          <input type="checkbox" name="profiles_enabled" value="1" checked
                 class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
          <span class="ml-2 text-sm text-gray-700"><%= t("federation_admin.partners.new.profiles_enabled") %></span>
          <span class="ml-2 text-xs text-gray-400"><%= t("federation_admin.partners.new.profiles_help") %></span>
        </label>
        <label class="flex items-center">
          <input type="hidden" name="listings_enabled" value="0">
          <input type="checkbox" name="listings_enabled" value="1" checked
                 class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
          <span class="ml-2 text-sm text-gray-700"><%= t("federation_admin.partners.new.listings_enabled") %></span>
          <span class="ml-2 text-xs text-gray-400"><%= t("federation_admin.partners.new.listings_help") %></span>
        </label>
        <label class="flex items-center">
          <input type="hidden" name="transactions_enabled" value="0">
          <input type="checkbox" name="transactions_enabled" value="1"
                 class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
          <span class="ml-2 text-sm text-gray-700"><%= t("federation_admin.partners.new.transactions_enabled") %></span>
          <span class="ml-2 text-xs text-gray-400"><%= t("federation_admin.partners.new.transactions_help") %></span>
        </label>
        <label class="flex items-center">
          <input type="hidden" name="messaging_enabled" value="0">
          <input type="checkbox" name="messaging_enabled" value="1"
                 class="rounded border-gray-300 text-federation-600 focus:ring-federation-500 h-4 w-4">
          <span class="ml-2 text-sm text-gray-700"><%= t("federation_admin.partners.new.messaging_enabled") %></span>
          <span class="ml-2 text-xs text-gray-400"><%= t("federation_admin.partners.new.messaging_help") %></span>
        </label>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <button type="submit"
              class="bg-federation-600 hover:bg-federation-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
        <%= t("federation_admin.partners.new.submit") %>
      </button>
      <a href="<%= federation_admin_partners_path %>"
         class="bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 font-medium py-2 px-4 rounded-md transition-colors">
        <%= t("federation_admin.partners.new.cancel") %>
      </a>
    </div>
  </form>
</div>
