<% content_for(:title) { t("federation_hub.messages.conversation_with", name: @message.remote_user_identifier) } %>
<% content_for(:breadcrumbs) do %>
  <li class="breadcrumb-item"><a href="<%= federation_hub_messages_path %>"><%= t("federation_hub.nav.messages") %></a></li>
  <li class="breadcrumb-item active" aria-current="page"><%= @message.remote_user_identifier %></li>
<% end %>

<div class="row mb-3">
  <div class="col-md-12">
    <a href="<%= federation_hub_messages_path %>" class="text-muted"><span aria-hidden="true">&larr;</span> <%= t("federation_hub.messages.back") %></a>
  </div>
</div>

<%# Conversation header %>
<div class="row mb-3">
  <div class="col-md-12">
    <h1 class="h4">
      <%= @message.metadata&.dig("sender_username") || @message.remote_user_identifier %>
      <small class="text-muted">
        &mdash; <%= @message.federation_partner&.name %>
      </small>
    </h1>
  </div>
</div>

<%# Message thread %>
<div class="card card-info border-info mb-3">
  <div class="card-body p-0">
    <% @thread.each do |msg| %>
      <div class="p-3 <%= msg.outbound? ? 'bg-light' : '' %> <%= msg == @thread.last ? '' : 'border-bottom' %>">
        <div class="d-flex justify-content-between mb-1">
          <div>
            <% if msg.inbound? %>
              <strong><%= msg.metadata&.dig("sender_username") || msg.remote_user_identifier %></strong>
            <% else %>
              <strong class="text-info"><%= t("federation_hub.messages.you") %></strong>
            <% end %>
            <% if msg.subject.present? %>
              <span class="text-muted ms-2">&mdash; <%= msg.subject %></span>
            <% end %>
          </div>
          <small class="text-muted"><%= format_date(msg.created_at) %></small>
        </div>
        <div class="mt-1">
          <%= simple_format(sanitize(msg.body, tags: [])) %>
        </div>
        <% if msg.outbound? %>
          <small class="text-muted">
            <% case msg.status %>
            <% when "delivered" %>
              <span class="text-success"><%= t("federation_hub.messages.status_delivered") %></span>
            <% when "pending" %>
              <span class="text-warning"><%= t("federation_hub.messages.status_pending") %></span>
            <% when "failed" %>
              <span class="text-danger"><%= t("federation_hub.messages.status_failed") %></span>
            <% end %>
          </small>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# Reply form %>
<div class="card border-info">
  <div class="card-body">
    <% if flash[:alert].present? %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= flash[:alert] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('federation_hub.common.close', default: 'Close') %>"></button>
      </div>
    <% end %>

    <form action="<%= federation_hub_messages_path %>" method="post" aria-label="<%= t('federation_hub.messages.reply_label', default: 'Reply message') %>">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="partner_id" value="<%= @message.federation_partner_id %>">
      <input type="hidden" name="recipient_id" value="<%= @message.remote_user_identifier %>">
      <input type="hidden" name="reply_to" value="<%= @message.id %>">
      <% reply_subject = @message.subject.present? && !@message.subject.start_with?("Re:") ? "Re: #{@message.subject}" : @message.subject %>
      <input type="hidden" name="subject" value="<%= reply_subject %>">

      <div class="mb-2">
        <label for="reply_body" class="form-label visually-hidden"><%= t("federation_hub.messages.reply_label", default: "Reply message") %></label>
        <textarea name="body" id="reply_body" rows="3" class="form-control" required aria-required="true" maxlength="10000"
                  placeholder="<%= t("federation_hub.messages.reply_placeholder") %>" data-char-counter="true"
                  aria-describedby="reply-counter"></textarea>
        <small id="reply-counter" class="text-muted char-counter" aria-live="polite"></small>
      </div>
      <button type="submit" class="btn btn-info">
        <%= t("federation_hub.messages.reply_button") %>
      </button>
    </form>
  </div>
</div>
