<% content_for(:title, t("federation_admin.reconciliation_runs.title")) %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("federation_admin.reconciliation_runs.title") %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= t("federation_admin.reconciliation_runs.subtitle") %></p>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <% if @runs.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.reconciliation_runs.table.id") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.reconciliation_runs.table.status") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.reconciliation_runs.table.critical") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.reconciliation_runs.table.warnings") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.reconciliation_runs.table.total") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.reconciliation_runs.table.duration") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("federation_admin.reconciliation_runs.table.run_at") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @runs.each do |run| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm font-mono">
                <a href="<%= federation_admin_reconciliation_run_path(run) %>" class="text-federation-600 hover:text-federation-800"><%= run.id %></a>
              </td>
              <td class="px-4 py-3 text-sm">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= run.healthy? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                  <%= run.status %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm <%= run.critical_count > 0 ? 'text-red-600 font-bold' : 'text-gray-500' %>"><%= run.critical_count %></td>
              <td class="px-4 py-3 text-sm <%= run.warning_count > 0 ? 'text-yellow-600' : 'text-gray-500' %>"><%= run.warning_count %></td>
              <td class="px-4 py-3 text-sm text-gray-500"><%= run.total_findings %></td>
              <td class="px-4 py-3 text-sm text-gray-500"><%= run.duration ? "#{run.duration.round(1)}s" : "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500"><%= format_date(run.created_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500"><%= t("federation_admin.reconciliation_runs.empty") %></p>
    </div>
  <% end %>
</div>
