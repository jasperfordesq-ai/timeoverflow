<% content_for(:title) { t("federation_hub.members.title") } %>

<div class="row">
  <div class="col-md-12">
    <h1><%= t("federation_hub.members.title") %></h1>
    <p class="text-muted"><%= t("federation_hub.members.subtitle") %></p>
  </div>
</div>

<%# Source selector — our community or a partner %>
<div class="row mb-4">
  <div class="col-md-6">
    <form method="get" action="<%= federation_hub_members_path %>">
      <div class="input-group">
        <select name="partner_id" class="form-control" onchange="this.form.submit()">
          <option value="" <%= 'selected' unless @selected_partner_id.present? %>><%= current_organization.name %> (<%= t("federation_hub.members.our_community") %>)</option>
          <% @partners.each do |p| %>
            <option value="<%= p.id %>" <%= 'selected' if @selected_partner_id.to_s == p.id.to_s %>><%= p.name %></option>
          <% end %>
        </select>
        <button type="submit" class="btn btn-info"><%= t("federation_hub.members.browse") %></button>
      </div>
    </form>
  </div>
  <div class="col-md-6">
    <p class="text-muted mt-2">
      <%= t("federation_hub.members.showing_from", source: @source_name) %>
      &mdash; <strong><%= @members.size %></strong> <%= t("federation_hub.members.members_count") %>
    </p>
  </div>
</div>

<% if @members.any? %>
  <div class="row">
    <% @members.each do |member| %>
      <div class="col-md-4 mb-3">
        <div class="card card-info border-info h-100">
          <div class="card-body">
            <h5 class="card-title">
              <%= sanitize(member["username"].to_s.presence || member["name"].to_s.presence || t("federation_hub.members.member_fallback", id: member["id"])) %>
            </h5>
            <% if member["balance"] %>
              <p class="card-text">
                <span class="badge bg-info">
                  <%= (member["balance"].to_f / 3600).round(1) %>h <%= t("federation_hub.members.balance") %>
                </span>
              </p>
            <% end %>
            <% tags = member["tags"] %>
            <% if tags.present? %>
              <p>
                <% tag_list = tags.is_a?(Array) ? tags : tags.to_s.split(",").map(&:strip) %>
                <% tag_list.first(5).each do |tag| %>
                  <% next if tag.blank? %>
                  <span class="badge rounded-pill bg-secondary"><%= sanitize(tag.to_s) %></span>
                <% end %>
              </p>
            <% end %>
            <small class="text-muted"><%= @source_name %></small>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    <%= t("federation_hub.members.none_found", partner: @source_name) %>
  </div>
<% end %>
