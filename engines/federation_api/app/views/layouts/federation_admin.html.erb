<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? "#{yield(:title)} — " : "" %><%= t("federation_admin.layout.title") %></title>
  <%# DESIGN SYSTEM: Tailwind CSS (self-contained, inlined)
      The admin panel intentionally uses Tailwind CSS while the member-facing
      Federation Hub uses Bootstrap 5. This is by design:
      - Hub (Bootstrap): matches the host TimeOverflow app's look and feel so
        members experience a consistent UI across the platform.
      - Admin (Tailwind): provides a distinct, purpose-built admin experience
        that is fully self-contained with zero host app dependencies.
      Both systems coexist without conflict because they render in separate
      layouts and page contexts. Do not attempt to unify them.

      Production-ready: compiled Tailwind CSS + Rails UJS bundled inline.
      No external CDN dependencies. To regenerate CSS after view changes:
      cd engines/federation_api && npx tailwindcss -i ./app/assets/stylesheets/federation_admin_input.css -o ./app/assets/stylesheets/federation_admin.css --minify %>
  <style><%= File.read(FederationApi::Engine.root.join("app/assets/stylesheets/federation_admin.css")) rescue "/* CSS not found — run: cd engines/federation_api && npx tailwindcss ... */" %></style>
  <script><%= raw File.read(FederationApi::Engine.root.join("app/assets/javascripts/rails-ujs.min.js")) rescue "" %></script>
  <script>if (typeof Rails !== 'undefined' && !window._rails_loaded) Rails.start();</script>
  <script><%= raw File.read(FederationApi::Engine.root.join("app/assets/javascripts/federation_form_helpers.js")) rescue "" %></script>
  <style>
    [data-flash] { animation: fadeOut 12s ease-in-out forwards; }
    @keyframes fadeOut { 0%,90% { opacity: 1; } 100% { opacity: 0; display: none; } }
    .overflow-x-auto { position: relative; }
    .scroll-shadow { background:
      linear-gradient(to right, white 30%, rgba(255,255,255,0)),
      linear-gradient(to right, rgba(255,255,255,0), white 70%) 100% 0,
      linear-gradient(to right, rgba(0,0,0,.08), rgba(0,0,0,0)),
      linear-gradient(to left, rgba(0,0,0,.08), rgba(0,0,0,0)) 100% 0;
      background-repeat: no-repeat;
      background-size: 40px 100%, 40px 100%, 14px 100%, 14px 100%;
      background-attachment: local, local, scroll, scroll;
    }
    .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border-width:0; }

  </style>
  <%= csrf_meta_tags %>
  <noscript><style>.js-only{display:none!important}</style></noscript>
</head>
<body class="h-full">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-white focus:text-federation-800 focus:shadow-lg">Skip to main content</a>
  <div class="min-h-full">
    <!-- Alpha development notice -->
    <div class="bg-amber-500 text-amber-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2 text-center text-sm font-semibold">
        <%= t("federation_admin.layout.alpha_notice") %>
      </div>
    </div>
    <!-- Top navigation bar -->
    <nav class="bg-federation-800 shadow-lg" aria-label="<%= t('federation_admin.layout.primary_navigation', default: 'Primary navigation') %>">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Top row: brand + back link -->
        <div class="flex h-12 items-center justify-between">
          <a href="<%= federation_admin_root_path %>" class="flex items-center gap-2 text-white font-bold tracking-tight">
            <span class="text-xl" aria-hidden="true">&#128279;</span>
            <%= t("federation_admin.layout.brand") %>
          </a>
          <div class="flex items-center gap-3">
            <a href="<%= main_app.root_path rescue '/' %>" class="text-federation-200 hover:text-white text-sm">
              &larr; <%= t("federation_admin.layout.back_to_timeoverflow") %>
            </a>
          </div>
        </div>
      </div>
      <!-- Nav links row -->
      <div class="border-t border-federation-700">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <% nav_items = [
            [federation_admin_root_path, t("federation_admin.layout.nav.dashboard")],
            [federation_admin_partners_path, t("federation_admin.layout.nav.partners")],
            [federation_admin_api_keys_path, t("federation_admin.layout.nav.api_keys")],
            [federation_admin_transactions_path, t("federation_admin.layout.nav.transactions")],
            [federation_admin_messages_path, t("federation_admin.layout.nav.messages")],
            [federation_admin_webhook_logs_path, t("federation_admin.layout.nav.webhooks")],
            [federation_admin_org_settings_path, t("federation_admin.layout.nav.orgs")],
            [federation_admin_member_preferences_path, t("federation_admin.layout.nav.members")],
            [federation_admin_activity_index_path, t("federation_admin.layout.nav.activity")],
            [federation_admin_reconciliation_runs_path, t("federation_admin.layout.nav.reconciliation", default: "Reconciliation")],
            [federation_admin_audit_logs_path, t("federation_admin.layout.nav.audit_logs", default: "Audit")],
            [federation_admin_cc_config_index_path, t("federation_admin.layout.nav.cc_config")]
          ] %>
          <!-- Mobile hamburger toggle -->
          <div class="sm:hidden flex items-center py-1">
            <button type="button" id="admin-nav-toggle" aria-expanded="false" aria-controls="admin-nav-links"
                    class="text-federation-200 hover:text-white text-sm font-medium px-3 py-1.5"
                    onclick="var el=document.getElementById('admin-nav-links');var open=el.classList.toggle('hidden');this.setAttribute('aria-expanded',!open);">
              <span aria-hidden="true">&#9776;</span> <%= t("federation_admin.layout.menu", default: "Menu") %>
            </button>
            <% if federation_stats[:transactions_pending] > 0 %>
              <span class="ml-auto inline-flex items-center rounded-full bg-yellow-400 px-2.5 py-0.5 text-xs font-semibold text-yellow-900 whitespace-nowrap">
                <%= t("federation_admin.layout.pending_count", count: federation_stats[:transactions_pending]) %>
              </span>
            <% end %>
          </div>
          <!-- Nav links — hidden on mobile until toggled -->
          <div id="admin-nav-links" class="hidden sm:flex items-center gap-1 py-1 overflow-x-auto flex-wrap">
            <% nav_items.each do |path, label| %>
              <% is_active = (path == federation_admin_root_path) ? (request.path == path) : request.path.start_with?(path) %>
              <a href="<%= path %>"
                 class="<%= is_active ? 'bg-federation-900 text-white' : 'text-federation-200 hover:bg-federation-700 hover:text-white' %> whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-colors">
                <%= label %>
              </a>
            <% end %>
            <% if federation_stats[:transactions_pending] > 0 %>
              <span class="ml-auto hidden sm:inline-flex items-center rounded-full bg-yellow-400 px-2.5 py-0.5 text-xs font-semibold text-yellow-900 whitespace-nowrap">
                <%= t("federation_admin.layout.pending_count", count: federation_stats[:transactions_pending]) %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <% if flash[:notice] %>
      <div data-flash class="mx-auto max-w-7xl px-4 mt-4" role="status" aria-live="polite">
        <div class="rounded-md bg-green-50 border border-green-200 p-4 flex items-start justify-between">
          <p class="text-sm font-medium text-green-800"><%= flash[:notice] %></p>
          <button type="button" onclick="this.closest('[data-flash]').remove()" class="ml-4 text-green-500 hover:text-green-700" aria-label="<%= t('federation_admin.common.close', default: 'Close') %>">&times;</button>
        </div>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mx-auto max-w-7xl px-4 mt-4" role="alert">
        <div class="rounded-md bg-red-50 border border-red-200 p-4 flex items-start justify-between">
          <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
          <button type="button" onclick="this.closest('.mx-auto').remove()" class="ml-4 text-red-500 hover:text-red-700" aria-label="<%= t('federation_admin.common.close', default: 'Close') %>">&times;</button>
        </div>
      </div>
    <% end %>

    <!-- Breadcrumbs -->
    <% if content_for?(:breadcrumbs) %>
      <nav aria-label="breadcrumb" class="mx-auto max-w-7xl px-4 mt-4">
        <ol class="flex items-center space-x-2 text-sm text-gray-500">
          <li><a href="<%= federation_admin_root_path %>" class="hover:text-federation-600"><%= t("federation_admin.layout.nav.dashboard") %></a></li>
          <%= yield :breadcrumbs %>
        </ol>
      </nav>
    <% end %>

    <!-- Main content -->
    <main id="main-content" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 mt-12">
      <div class="mx-auto max-w-7xl px-4 py-6 text-center text-xs text-gray-400">
        <%= t("federation_admin.layout.footer", version: FederationApi::VERSION) %>
      </div>
    </footer>
  </div>
</body>
</html>
