<% content_for(:title) { t("federation_hub.members.title") } %>

<div class="row">
  <div class="col-md-12">
    <h1><%= t("federation_hub.members.title") %></h1>
    <p class="text-muted"><%= t("federation_hub.members.subtitle") %></p>
  </div>
</div>

<%# Partner selector with grouped options %>
<div class="row mb-4">
  <div class="col-md-6">
    <form method="get" action="<%= federation_hub_members_path %>" aria-label="<%= t('federation_hub.members.select_partner') %>">
      <div class="input-group">
        <label for="partner_select" class="visually-hidden"><%= t("federation_hub.members.select_partner") %></label>
        <select name="partner_id" id="partner_select" class="form-control" aria-label="<%= t("federation_hub.members.select_partner") %>" onchange="
          var opt = this.options[this.selectedIndex];
          document.getElementById('source_type_field').value = opt.dataset.type || '';
          this.form.submit();
        ">
          <option value=""><%= t("federation_hub.members.select_partner") %></option>

          <% if @internal_orgs.any? %>
            <optgroup label="<%= t("federation_hub.common.internal_orgs") %>">
              <% @internal_orgs.each do |org| %>
                <option value="<%= org.id %>"
                        data-type="internal"
                        <%= 'selected' if @selected_id.to_s == org.id.to_s && @selected_type == "internal" %>>
                  <%= org.name %>
                </option>
              <% end %>
            </optgroup>
          <% end %>

          <% if @external_partners.any? %>
            <optgroup label="<%= t("federation_hub.common.external_partners") %>">
              <% @external_partners.each do |p| %>
                <option value="<%= p.id %>"
                        data-type="external"
                        <%= 'selected' if @selected_id.to_s == p.id.to_s && @selected_type != "internal" %>>
                  <%= p.name %>
                </option>
              <% end %>
            </optgroup>
          <% end %>
        </select>
        <input type="hidden" name="source_type" id="source_type_field" value="<%= @selected_type %>">
        <button type="submit" class="btn btn-info"><%= t("federation_hub.members.browse") %></button>
      </div>
    </form>
  </div>
  <% if @selected_id.present? && @source_name %>
    <div class="col-md-6">
      <p class="text-muted mt-2">
        <%= t("federation_hub.members.showing_from", source: @source_name) %>
        &mdash; <strong><%= @members.size %></strong> <%= t("federation_hub.members.members_count") %>
      </p>
    </div>
  <% end %>
</div>

<% if @selected_id.blank? %>
  <div class="alert alert-info">
    <%= t("federation_hub.members.choose_partner") %>
  </div>
<% elsif @members.any? %>
  <div class="row">
    <% @members.each do |member| %>
      <div class="col-12 col-sm-6 col-md-4 mb-3">
        <div class="card card-info border-info h-100">
          <div class="card-body">
            <h2 class="h5 card-title">
              <%= sanitize(member["username"].to_s.presence || member["name"].to_s.presence || t("federation_hub.members.member_fallback", id: member["id"])) %>
            </h2>
            <% if member["balance"] %>
              <p class="card-text">
                <span class="badge rounded-pill bg-info">
                  <%= format_federation_hours(member["balance"]) %> <%= t("federation_hub.members.balance") %>
                </span>
              </p>
            <% end %>
            <% tags = member["tags"] %>
            <% if tags.present? %>
              <p>
                <% tag_list = tags.is_a?(Array) ? tags : tags.to_s.split(",").map(&:strip) %>
                <% tag_list.first(5).each do |tag| %>
                  <% next if tag.blank? %>
                  <span class="badge rounded-pill bg-secondary"><%= sanitize(tag.to_s) %></span>
                <% end %>
              </p>
            <% end %>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <small class="text-muted"><%= member["organization"] || @source_name %></small>
              <div class="d-flex gap-1">
                <% if @selected_type == "internal" %>
                  <a href="<%= new_federation_hub_transfer_path(org_id: @selected_id, member_id: member["id"]) %>"
                     class="btn btn-sm btn-success">
                    <%= t("federation_hub.members.send_time") %>
                  </a>
                <% else %>
                  <a href="<%= new_federation_hub_message_path(partner_id: @selected_id, recipient_id: member["id"], recipient_name: member["username"]) %>"
                     class="btn btn-sm btn-info">
                    <%= t("federation_hub.members.send_message") %>
                  </a>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <div class="d-flex justify-content-between align-items-center mt-3">
      <small class="text-muted"><%= t("federation_hub.common.page") %> <%= @current_page %> / <%= @total_pages %> (<%= @total_count %> <%= t("federation_hub.members.total", default: "total") %>)</small>
      <nav aria-label="<%= t('federation_hub.common.pagination', default: 'Pagination') %>">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= 'disabled' if @current_page <= 1 %>">
            <a class="page-link" href="<%= federation_hub_members_path(request.query_parameters.merge(page: @current_page - 1)) %>"><%= t("federation_hub.common.previous", default: "Previous") %></a>
          </li>
          <li class="page-item <%= 'disabled' if @current_page >= @total_pages %>">
            <a class="page-link" href="<%= federation_hub_members_path(request.query_parameters.merge(page: @current_page + 1)) %>"><%= t("federation_hub.common.next_page", default: "Next") %></a>
          </li>
        </ul>
      </nav>
    </div>
  <% end %>
<% else %>
  <div class="alert alert-info">
    <%= t("federation_hub.members.none_found", partner: @source_name) %>
  </div>
<% end %>
