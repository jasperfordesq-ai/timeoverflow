<% content_for(:title, t('federation_admin.cc_config.title')) %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900"><%= t('federation_admin.cc_config.title') %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= t('federation_admin.cc_config.subtitle') %></p>
</div>

<% @organizations.each do |org| %>
  <% config = @configs[org.id] %>
  <div class="bg-white shadow rounded-lg p-6 max-w-2xl mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= org.name %></h2>

    <form action="<%= federation_admin_cc_config_index_path %>" method="post">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="_method" value="patch">
      <input type="hidden" name="organization_id" value="<%= config&.organization_id || org.id %>">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="node_slug_<%= org.id %>" class="block text-xs font-medium text-gray-500 uppercase"><%= t('federation_admin.cc_config.node_slug') %></label>
          <input type="text" name="node_slug" id="node_slug_<%= org.id %>" value="<%= config&.node_slug || "" %>" required
                 pattern="[0-9a-z\-]{3,15}"
                 class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2 text-sm">
        </div>

        <div>
          <label for="currency_format_<%= org.id %>" class="block text-xs font-medium text-gray-500 uppercase"><%= t('federation_admin.cc_config.currency_format') %></label>
          <input type="text" name="currency_format" id="currency_format_<%= org.id %>" value="<%= config&.currency_format || "" %>"
                 class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2 text-sm">
        </div>

        <div>
          <label for="exchange_rate_<%= org.id %>" class="block text-xs font-medium text-gray-500 uppercase"><%= t('federation_admin.cc_config.exchange_rate') %></label>
          <input type="number" name="exchange_rate" id="exchange_rate_<%= org.id %>" value="<%= config&.exchange_rate || "" %>" step="0.0001" min="0.01"
                 class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2 text-sm">
        </div>

        <div>
          <label for="validated_window_<%= org.id %>" class="block text-xs font-medium text-gray-500 uppercase"><%= t('federation_admin.cc_config.validated_window') %></label>
          <input type="number" name="validated_window" id="validated_window_<%= org.id %>" value="<%= config&.validated_window || "" %>" min="30" max="86400"
                 class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2 text-sm">
        </div>

        <div class="sm:col-span-2">
          <label for="parent_node_url_<%= org.id %>" class="block text-xs font-medium text-gray-500 uppercase"><%= t('federation_admin.cc_config.parent_node_url') %></label>
          <input type="url" name="parent_node_url" id="parent_node_url_<%= org.id %>" value="<%= config&.parent_node_url || "" %>"
                 placeholder="<%= t('federation_admin.cc_config.parent_placeholder') %>"
                 class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm px-3 py-2 text-sm">
        </div>
      </div>

      <div class="mt-4 flex items-center justify-between">
        <div class="text-xs text-gray-400">
          <% if config&.persisted? %>
            Node: <span class="font-mono"><%= config.node_slug %></span> &middot;
            <%= config.root_node? ? t('federation_admin.cc_config.root_node') : t('federation_admin.cc_config.child_node') %> &middot;
            <%= t('federation_admin.cc_config.cc_endpoints') %> <span class="font-mono">/api/v1/cc/about</span>
          <% end %>
        </div>
        <button type="submit" class="inline-flex items-center rounded-md bg-federation-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-federation-500">
          <%= t('federation_admin.cc_config.save') %>
        </button>
      </div>
    </form>
  </div>
<% end %>
