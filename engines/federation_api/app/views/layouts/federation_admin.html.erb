<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? "#{yield(:title)} — " : "" %>Federation Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            federation: {
              50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd',
              400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8',
              800: '#1e40af', 900: '#1e3a8a'
            }
          }
        }
      }
    }
  </script>
  <!-- Rails UJS for data-method="delete" and data-confirm support -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/rails-ujs/5.2.8.1/rails-ujs.min.js"></script>
  <script>if (typeof Rails !== 'undefined') Rails.start();</script>
  <style>
    [data-flash] { animation: fadeOut 8s ease-in-out forwards; }
    @keyframes fadeOut { 0%,85% { opacity: 1; } 100% { opacity: 0; display: none; } }
  </style>
  <%= csrf_meta_tags %>
</head>
<body class="h-full">
  <div class="min-h-full">
    <!-- Top navigation bar -->
    <nav class="bg-federation-800 shadow-lg">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0">
              <span class="text-2xl">🔗</span>
            </div>
            <a href="/federation-admin" class="text-white font-bold text-lg tracking-tight">
              Federation Admin
            </a>
            <span class="hidden sm:inline-block text-federation-300 text-xs font-mono bg-federation-900 px-2 py-0.5 rounded">
              v<%= FederationApi::VERSION %>
            </span>
          </div>

          <!-- Nav links -->
          <div class="hidden md:flex items-center space-x-1">
            <% nav_items = [
              ["/federation-admin", "Dashboard", "dashboard"],
              ["/federation-admin/partners", "Partners", "partners"],
              ["/federation-admin/api_keys", "API Keys", "api_keys"],
              ["/federation-admin/transactions", "Transactions", "transactions"],
              ["/federation-admin/messages", "Messages", "messages"],
              ["/federation-admin/webhook_logs", "Webhooks", "webhook_logs"],
              ["/federation-admin/org_settings", "Org Settings", "org_settings"]
            ] %>
            <% nav_items.each do |path, label, id| %>
              <a href="<%= path %>"
                 class="<%= request.path.start_with?(path) && (path != '/federation-admin' || request.path == '/federation-admin') ? 'bg-federation-900 text-white' : 'text-federation-200 hover:bg-federation-700 hover:text-white' %> rounded-md px-3 py-2 text-sm font-medium transition-colors">
                <%= label %>
              </a>
            <% end %>
          </div>

          <div class="flex items-center gap-4">
            <% if federation_stats[:transactions_pending] > 0 %>
              <span class="inline-flex items-center rounded-full bg-yellow-400 px-2.5 py-0.5 text-xs font-semibold text-yellow-900">
                <%= federation_stats[:transactions_pending] %> pending
              </span>
            <% end %>
            <span class="text-federation-300 text-sm hidden lg:inline">
              <%= current_user&.username || current_user&.email %>
            </span>
            <a href="/" class="text-federation-300 hover:text-white text-sm">
              ← Back to TimeOverflow
            </a>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div class="md:hidden border-t border-federation-700 px-4 py-2 flex flex-wrap gap-1">
        <% nav_items&.each do |path, label, _| %>
          <a href="<%= path %>" class="text-federation-200 hover:text-white text-sm px-2 py-1"><%= label %></a>
        <% end %>
      </div>
    </nav>

    <!-- Flash messages -->
    <% if flash[:notice] %>
      <div data-flash class="mx-auto max-w-7xl px-4 mt-4">
        <div class="rounded-md bg-green-50 border border-green-200 p-4">
          <p class="text-sm font-medium text-green-800"><%= flash[:notice] %></p>
        </div>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div data-flash class="mx-auto max-w-7xl px-4 mt-4">
        <div class="rounded-md bg-red-50 border border-red-200 p-4">
          <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
        </div>
      </div>
    <% end %>

    <!-- Main content -->
    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 mt-12">
      <div class="mx-auto max-w-7xl px-4 py-6 text-center text-xs text-gray-400">
        Federation Engine v<%= FederationApi::VERSION %> · Self-contained module · Does not modify TimeOverflow core
      </div>
    </footer>
  </div>
</body>
</html>
