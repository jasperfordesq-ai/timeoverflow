<% content_for(:title, "Webhook Logs") %>

<%
  def status_badge_class(status)
    case status.to_s
    when "active", "completed", "success" then "bg-green-100 text-green-800"
    when "pending" then "bg-yellow-100 text-yellow-800"
    when "suspended", "cancelled" then "bg-gray-100 text-gray-800"
    when "terminated", "failed", "disputed" then "bg-red-100 text-red-800"
    else "bg-gray-100 text-gray-600"
    end
  end

  def direction_badge_class(direction)
    case direction.to_s
    when "inbound" then "bg-blue-100 text-blue-800"
    when "outbound" then "bg-purple-100 text-purple-800"
    else "bg-gray-100 text-gray-600"
    end
  end
%>

<div class="sm:flex sm:items-center sm:justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Webhook Logs</h1>
    <p class="mt-1 text-sm text-gray-500"><%= @total_count %> total log<%= @total_count == 1 ? '' : 's' %></p>
  </div>
</div>

<!-- Filter Bar -->
<div class="bg-white shadow rounded-lg p-4 mb-6">
  <form method="get" action="<%= federation_admin_webhook_logs_path %>" class="flex flex-wrap items-end gap-4">
    <div>
      <label for="status" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Status</label>
      <select name="status" id="status" onchange="this.form.submit()"
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value="">All Statuses</option>
        <% %w[pending success failed].each do |s| %>
          <option value="<%= s %>" <%= params[:status] == s ? 'selected' : '' %>><%= s.capitalize %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="direction" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Direction</label>
      <select name="direction" id="direction" onchange="this.form.submit()"
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value="">All Directions</option>
        <% %w[inbound outbound].each do |d| %>
          <option value="<%= d %>" <%= params[:direction] == d ? 'selected' : '' %>><%= d.capitalize %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label for="partner_id" class="block text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Partner</label>
      <select name="partner_id" id="partner_id" onchange="this.form.submit()"
              class="block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-federation-500 focus:ring-federation-500">
        <option value="">All Partners</option>
        <% @partners.each do |partner| %>
          <option value="<%= partner.id %>" <%= params[:partner_id].to_s == partner.id.to_s ? 'selected' : '' %>><%= partner.name %></option>
        <% end %>
      </select>
    </div>

    <% if params[:status].present? || params[:direction].present? || params[:partner_id].present? %>
      <div>
        <a href="<%= federation_admin_webhook_logs_path %>"
           class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700">
          Clear filters
        </a>
      </div>
    <% end %>
  </form>
</div>

<!-- Table -->
<div class="bg-white shadow rounded-lg overflow-hidden">
  <% if @logs.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Partner</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event Type</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Direction</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Response Code</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Attempt</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @logs.each do |log| %>
            <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='<%= federation_admin_webhook_log_path(log) %>'">
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap font-mono"><%= log.id %></td>
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
                <%= log.federation_partner&.name || "N/A" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap font-mono"><%= log.event_type %></td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= direction_badge_class(log.direction) %>">
                  <%= log.direction %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_badge_class(log.status) %>">
                  <%= log.status %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap font-mono"><%= log.response_code || "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= log.attempt_number || "-" %></td>
              <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between border-t border-gray-200 px-4 py-3 mt-4">
      <div class="text-sm text-gray-700">
        Page <span class="font-medium"><%= @current_page %></span> of <span class="font-medium"><%= @total_pages %></span>
      </div>
      <div class="flex space-x-2">
        <% if @current_page > 1 %>
          <a href="<%= federation_admin_webhook_logs_path(request.query_parameters.merge(page: @current_page - 1)) %>"
             class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Previous
          </a>
        <% else %>
          <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 opacity-50 cursor-not-allowed">
            Previous
          </span>
        <% end %>

        <% if @current_page < @total_pages %>
          <a href="<%= federation_admin_webhook_logs_path(request.query_parameters.merge(page: @current_page + 1)) %>"
             class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            Next
          </a>
        <% else %>
          <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 opacity-50 cursor-not-allowed">
            Next
          </span>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-sm text-gray-500">No webhook logs found.</p>
    </div>
  <% end %>
</div>
